---
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import bricolageUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { url, absoluteUrl } from '../lib';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  lang?: string;
  hreflang?: string;
  track?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, path, ogImage, lang = 'en', hreflang, track, noindex = false, jsonLd } = Astro.props;
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const canonical = absoluteUrl(path);
const og = ogImage ? absoluteUrl(ogImage) : undefined;
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL?.trim();
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FFD23F" />
    <link rel="canonical" href={canonical} />
    {hreflang && <link rel="alternate" hreflang={hreflang} href={canonical} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="preload" href={bricolageUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DataTalks.Club Academy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og && <meta property="og:image" content={og} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {og && <meta name="twitter:image" content={og} />}
    {umamiScriptUrl && umamiWebsiteId && (
      <script defer src={umamiScriptUrl} data-website-id={umamiWebsiteId}></script>
    )}
    {jsonLdItems.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
  </head>
  <body data-track={track}>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script>
      import '../scripts/signup';
    </script>
  </body>
</html>
