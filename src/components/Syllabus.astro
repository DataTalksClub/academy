---
import SectionHead from './SectionHead.astro';
import { syllabus } from '../data/shared';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
let n = 0;
---

<section id="syllabus" class="section" aria-labelledby="syllabus-title">
  <div class="wrap split">
    <SectionHead title={syllabus.heading} titleId="syllabus-title">
      <p class="intro">{syllabus.intro}</p>
    </SectionHead>
    <div class="split__body">
      {
        track.syllabus.map((g, gi) => (
          <details class="group" open={gi === 0}>
            <summary>
              <span class="mono group__weeks">{g.weeks}</span>
              <span class="group__title">{g.title}</span>
              <span class="plus" aria-hidden="true" />
            </summary>
            <ol class="modules">
              {g.modules.map((m) => {
                n += 1;
                return (
                  <li>
                    <span class="mono mod__n">{String(n).padStart(2, '0')}</span>
                    <span class="mod__body">
                      <span class="mod__title">{m.title}</span>
                      <span class="mod__produce">
                        <span class="mono">You produce:</span> {m.produce}
                      </span>
                    </span>
                  </li>
                );
              })}
            </ol>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    margin: 20px 0 0;
    color: var(--muted);
    max-width: 26rem;
  }
  .split__body {
    position: relative;
  }
  .group {
    position: relative;
    padding-left: 30px;
  }
  .group::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }
  .group:first-child::before {
    top: 30px;
  }
  .group:last-child:not([open])::before {
    bottom: calc(100% - 30px);
  }
  summary {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 20px;
    align-items: baseline;
    gap: 6px 16px;
    padding: 18px 16px;
    margin-bottom: 8px;
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    cursor: pointer;
  }
  summary:hover {
    border-color: #4a535e;
  }
  summary::before {
    content: '';
    position: absolute;
    left: -30px;
    top: 24px;
    width: 13px;
    height: 13px;
    border: 2px solid var(--lime);
    border-radius: 50%;
    background: var(--bg);
  }
  details[open] summary::before {
    background: var(--lime);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .group__weeks {
    color: var(--lime);
    text-transform: uppercase;
    font-weight: 500;
  }
  .group__title {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .plus {
    position: relative;
    width: 14px;
    height: 14px;
    align-self: center;
    justify-self: end;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    background: var(--muted);
    left: 0;
    top: 6.25px;
    width: 14px;
    height: 1.5px;
  }
  .plus::after {
    transform: rotate(90deg);
    transition: transform 160ms;
  }
  details[open] .plus::after {
    transform: rotate(0);
  }
  .modules {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
  }
  .modules li {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 4px 12px;
    padding: 14px 4px 14px 16px;
    border-bottom: 1px dashed var(--border);
  }
  .modules li::before {
    content: '';
    position: absolute;
    left: -27px;
    top: 24px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #6e7681;
  }
  .mod__n {
    color: var(--muted);
    padding-top: 3px;
  }
  .mod__title {
    display: block;
    font-weight: 600;
  }
  .mod__produce {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .mod__produce .mono {
    color: var(--cyan);
    text-transform: uppercase;
    margin-right: 4px;
    font-size: 0.6875rem;
    font-weight: 600;
  }
  @media (max-width: 559px) {
    .group {
      padding-left: 24px;
    }
    summary {
      grid-template-columns: minmax(0, 1fr) 20px;
      padding: 14px;
    }
    summary::before {
      left: -24px;
    }
    .modules li {
      grid-template-columns: 2rem minmax(0, 1fr);
      padding-left: 6px;
    }
    .modules li::before {
      left: -21px;
    }
    .group__weeks {
      grid-column: 1;
    }
    .group__title {
      grid-column: 1;
    }
    .plus {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
