---
import SectionHead from './SectionHead.astro';
import { syllabus } from '../data/shared';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
let n = 0;
---

<section id="syllabus" class="section" aria-labelledby="syllabus-title">
  <div class="wrap split">
    <SectionHead title={syllabus.heading} titleId="syllabus-title">
      <p class="intro">{syllabus.intro}</p>
    </SectionHead>
    <div class="split__body">
      {
        track.syllabus.map((g, gi) => (
          <details class="group" open={gi === 0}>
            <summary>
              <span class="mono group__weeks">{g.weeks}</span>
              <span class="group__title">{g.title}</span>
              <span class="plus" aria-hidden="true" />
            </summary>
            <ol class="modules">
              {g.modules.map((m) => {
                n += 1;
                return (
                  <li>
                    <span class="mono mod__n">{String(n).padStart(2, '0')}</span>
                    <span class="mod__body">
                      <span class="mod__title">{m.title}</span>
                      <span class="mod__produce">
                        <span class="mono">You produce:</span> {m.produce}
                      </span>
                    </span>
                  </li>
                );
              })}
            </ol>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  #syllabus {
    background: var(--tint-blue);
  }
  .intro {
    margin: 20px 0 0;
    color: var(--black);
    max-width: 26rem;
  }
  .split__body {
    display: grid;
    gap: 18px;
  }
  .group {
    background: var(--white);
    border: var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) 34px;
    align-items: center;
    gap: 8px 16px;
    padding: 16px 18px;
    min-height: 44px;
    cursor: pointer;
    border-radius: 11px;
  }
  details[open] summary {
    border-bottom: var(--border);
    border-radius: 11px 11px 0 0;
    background: var(--yellow);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .group__weeks {
    justify-self: start;
    padding: 3px 9px;
    background: var(--black);
    color: var(--white);
    border-radius: 999px;
    text-transform: uppercase;
    font-weight: 700;
    white-space: nowrap;
  }
  .group__title {
    font-family: var(--display);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .plus {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border: var(--border);
    border-radius: 50%;
    background: var(--yellow);
    align-self: center;
    justify-self: end;
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    background: var(--black);
    left: 50%;
    top: 50%;
    width: 14px;
    height: 3px;
    margin: -1.5px 0 0 -7px;
  }
  .plus::after {
    transform: rotate(90deg);
    transition: transform 160ms;
  }
  details[open] .plus {
    background: var(--white);
  }
  details[open] .plus::after {
    transform: rotate(0);
  }

  .modules {
    list-style: none;
    margin: 0;
    padding: 4px 18px 10px;
  }
  .modules li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 4px 14px;
    padding: 14px 0;
  }
  .modules li + li {
    border-top: 2px dashed var(--black);
  }
  .mod__n {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 2px solid var(--black);
    border-radius: 50%;
    font-weight: 700;
  }
  .mod__title {
    display: block;
    font-weight: 700;
  }
  .mod__produce {
    display: block;
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .mod__produce .mono {
    display: inline-block;
    padding: 0 6px;
    background: var(--tint-mint);
    border: 2px solid var(--black);
    border-radius: 6px;
    color: var(--black);
    text-transform: uppercase;
    margin-right: 4px;
    font-size: 0.6875rem;
    font-weight: 700;
  }
  @media (max-width: 559px) {
    summary {
      grid-template-columns: minmax(0, 1fr) 34px;
    }
    .group__weeks {
      grid-column: 1;
    }
    .group__title {
      grid-column: 1;
    }
    .plus {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
