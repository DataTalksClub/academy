---
interface Props {
  size?: 'lg' | 'sm';
  numbered?: boolean;
}
const { size = 'lg', numbered = false } = Astro.props;
const CELL = 60;
const GAP = 10;
const PAD = 2;
const W = 5 * CELL + 4 * GAP + PAD * 2;
const H = 3 * CELL + 2 * GAP + PAD * 2;
// Contribution-graph style intensity per seat (decorative).
const LEVELS = [4, 2, 3, 4, 1, 3, 4, 2, 4, 3, 1, 4, 3, 2, 4];
const seats = Array.from({ length: 15 }, (_, i) => ({
  i,
  lv: LEVELS[i],
  x: PAD + (i % 5) * (CELL + GAP),
  y: PAD + Math.floor(i / 5) * (CELL + GAP),
}));
---

<svg
  class={`seats seats--${size}`}
  viewBox={`0 0 ${W} ${H}`}
  width={W}
  height={H}
  aria-hidden="true"
  focusable="false"
>
  {
    seats.map((s) => (
      <g style={`--i:${s.i}`} class={`lv${s.lv}`}>
        <rect x={s.x} y={s.y} width={CELL} height={CELL} rx="6" />
        {numbered && (
          <text x={s.x + 9} y={s.y + 20}>
            {String(s.i + 1).padStart(2, '0')}
          </text>
        )}
      </g>
    ))
  }
</svg>

<style>
  .seats {
    display: block;
    width: 100%;
    height: auto;
    color: var(--seat, var(--lime));
    overflow: visible;
  }
  .seats--sm {
    max-width: 150px;
  }
  rect {
    fill: currentColor;
    stroke: rgba(230, 237, 243, 0.06);
    stroke-width: 1;
  }
  .lv1 rect {
    fill-opacity: 0.22;
  }
  .lv2 rect {
    fill-opacity: 0.45;
  }
  .lv3 rect {
    fill-opacity: 0.72;
  }
  .lv4 rect {
    fill-opacity: 1;
  }
  text {
    fill: #0d1117;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 12px;
  }
  .lv1 text,
  .lv2 text {
    fill: #e6edf3;
  }
</style>
