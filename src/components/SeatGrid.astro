---
interface Props {
  size?: 'lg' | 'sm';
  numbered?: boolean;
}
const { size = 'lg', numbered = false } = Astro.props;
const CELL = 60;
const GAP = 16;
const PAD = 2;
const W = 5 * CELL + 4 * GAP + PAD * 2;
const H = 3 * CELL + 2 * GAP + PAD * 2;
const seats = Array.from({ length: 15 }, (_, i) => ({
  i,
  x: PAD + (i % 5) * (CELL + GAP),
  y: PAD + Math.floor(i / 5) * (CELL + GAP),
}));
---

<svg
  class={`seats seats--${size}`}
  viewBox={`0 0 ${W} ${H}`}
  width={W}
  height={H}
  aria-hidden="true"
  focusable="false"
>
  {
    seats.map((s) => (
      <g style={`--i:${s.i}`}>
        <rect x={s.x} y={s.y} width={CELL} height={CELL} pathLength="1" />
        {numbered && (
          <text x={s.x + 9} y={s.y + 20}>
            {String(s.i + 1).padStart(2, '0')}
          </text>
        )}
      </g>
    ))
  }
</svg>

<style>
  .seats {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(4px 4px 0 var(--black));
  }
  .seats--sm {
    max-width: 150px;
  }
  rect {
    fill: var(--white);
    stroke: var(--black);
    stroke-width: 3;
    rx: 8px;
  }
  g:nth-child(4n + 1) rect { fill: var(--blue); }
  g:nth-child(4n + 2) rect { fill: var(--coral); }
  g:nth-child(4n + 3) rect { fill: var(--green); }
  g:nth-child(4n + 4) rect { fill: var(--white); }
  .seats--sm rect {
    stroke-width: 5;
  }
  text {
    fill: var(--black);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 12px;
  }
  g:nth-child(4n + 1) text { fill: var(--white); }
</style>
