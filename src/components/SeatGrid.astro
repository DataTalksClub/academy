---
interface Props {
  size?: 'lg' | 'sm';
  numbered?: boolean;
}
const { size = 'lg', numbered = false } = Astro.props;
const CELL = 60;
const GAP = 16;
const PAD = 2;
const W = 5 * CELL + 4 * GAP + PAD * 2;
const H = 3 * CELL + 2 * GAP + PAD * 2;
const seats = Array.from({ length: 15 }, (_, i) => ({
  i,
  x: PAD + (i % 5) * (CELL + GAP),
  y: PAD + Math.floor(i / 5) * (CELL + GAP),
}));
---

<svg
  class={`seats seats--${size}`}
  viewBox={`0 0 ${W} ${H}`}
  width={W}
  height={H}
  aria-hidden="true"
  focusable="false"
>
  {
    seats.map((s) => (
      <g style={`--i:${s.i}`}>
        <rect x={s.x} y={s.y} width={CELL} height={CELL} pathLength="1" />
        {numbered && (
          <text x={s.x + 9} y={s.y + 20}>
            {String(s.i + 1).padStart(2, '0')}
          </text>
        )}
      </g>
    ))
  }
</svg>

<style>
  .seats {
    display: block;
    width: 100%;
    height: auto;
    color: var(--seat, var(--mint));
    overflow: visible;
  }
  .seats--sm {
    max-width: 150px;
  }
  rect {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: draw 160ms ease-out backwards;
    animation-delay: calc(var(--i) * 32ms);
  }
  .seats--sm rect {
    stroke-width: 3.2;
  }
  text {
    fill: currentColor;
    opacity: 0.7;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    animation: fade 200ms ease-out backwards;
    animation-delay: calc(var(--i) * 32ms + 80ms);
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    rect,
    text {
      animation: none;
    }
  }
</style>
