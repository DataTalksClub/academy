---
import { url } from '../lib';
import { form } from '../data/shared';
interface Props {
  id: 'hero' | 'join';
}
const { id } = Astro.props;
---

<div class="signup card" id={`signup-${id}`} data-signup={id}>
  <form class="signup__form" novalidate>
    <label class="mono field-label" for={`email-${id}`}>{form.label}</label>
    <div class="signup__row">
      <input
        class="input"
        id={`email-${id}`}
        type="email"
        name="email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder="you@example.com"
        aria-describedby={`email-err-${id} email-micro-${id}`}
      />
      <button class="btn btn--green" type="submit" disabled data-needs-js>{form.button}</button>
    </div>
    <div class="hp" aria-hidden="true">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <p class="field-error mono" id={`email-err-${id}`} data-error="invalid" hidden>
      {form.error}
    </p>
    <p class="field-error mono" data-error="failed" role="alert" hidden>
      That didn't go through. Please try again, or email <a href="mailto:alexey@datatalks.club">alexey@datatalks.club</a> and I'll add you.
    </p>
    <noscript>
      <p class="field-error mono">
        Signing up needs JavaScript. Or email <a href="mailto:alexey@datatalks.club">alexey@datatalks.club</a> and I'll add you.
      </p>
    </noscript>
    <p class="micro mono" id={`email-micro-${id}`}>
      {form.micro} <a href={url('/privacy/')}>Privacy</a>
    </p>
  </form>

  <div class="success" data-success hidden>
    <p class="mono label-green">Check your inbox</p>
    <h3 class="success__title" tabindex="-1" data-success-title>
      Confirm your email
    </h3>
    <p>
      I sent a confirmation link to your email. Click it to confirm your spot on the shortlist.
    </p>

    <p class="mono label-green success__q">Two quick questions (optional)</p>
    <div class="chips" role="group" aria-label="Where are you based?">
      <span class="chips__q">Where are you based?</span>
      <span class="chips__set">
        <button type="button" class="chip" data-group="location" data-value="berlin" aria-pressed="false">Berlin</button>
        <button type="button" class="chip" data-group="location" data-value="germany" aria-pressed="false">Elsewhere in Germany</button>
        <button type="button" class="chip" data-group="location" data-value="outside-germany" aria-pressed="false">Outside Germany</button>
      </span>
    </div>
    <div class="chips" role="group" aria-label="How would you pay?">
      <span class="chips__q">How would you pay?</span>
      <span class="chips__set">
        <button type="button" class="chip" data-group="funding" data-value="bildungsgutschein" aria-pressed="false">Bildungsgutschein</button>
        <button type="button" class="chip" data-group="funding" data-value="self" aria-pressed="false">Myself</button>
        <button type="button" class="chip" data-group="funding" data-value="employer" aria-pressed="false">My employer</button>
        <button type="button" class="chip" data-group="funding" data-value="unsure" aria-pressed="false">Not sure yet</button>
      </span>
    </div>

    <p class="field-error mono" data-error="answers" role="alert" hidden>
      That answer didn't save. Please tap it again.
    </p>

    <p class="success__survey">I use the survey answers to shape the syllabus.</p>
    <a class="btn btn--outline" href="#" target="_blank" rel="noopener" data-survey>Take the survey</a>
  </div>
</div>

<style>
  .signup {
    --focus: var(--lime);
    position: relative;
    background: var(--panel);
    color: var(--fg);
    border: 1px solid var(--border);
    border-top: 2px solid var(--lime);
    border-radius: var(--radius);
    padding: 20px 18px 18px;
  }
  @media (min-width: 768px) {
    .signup {
      padding: 26px 26px 22px;
    }
  }
  .field-label {
    display: block;
    margin-bottom: 10px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .field-label::before {
    content: '> ';
    color: var(--lime);
  }
  .signup__row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  @media (min-width: 560px) {
    .signup__row {
      flex-direction: row;
    }
    .signup__row .input {
      flex: 1;
      min-width: 0;
    }
  }
  .input {
    width: 100%;
    min-height: 50px;
    padding: 0 14px;
    border: 1px solid #484f58;
    border-radius: var(--radius);
    background: var(--bg-deep);
    color: var(--fg);
    caret-color: var(--lime);
    font: 400 0.9375rem/1.2 var(--mono);
  }
  .input:focus {
    border-color: var(--lime);
  }
  .input::placeholder {
    color: #8b949e;
  }
  .input[aria-invalid='true'] {
    border-color: var(--error);
    box-shadow: inset 0 0 0 1px var(--error);
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .field-error {
    margin: 10px 0 0;
    color: var(--error);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .field-error a {
    color: inherit;
    text-decoration: underline;
  }
  .micro {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.65;
  }
  .micro a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .success__title {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 8px 0 14px;
    outline: none;
  }
  .success > p:not(.mono) {
    margin: 0 0 20px;
    font-size: 0.96875rem;
    color: #c9d1d9;
  }
  .label-green {
    margin: 0;
    color: var(--lime);
    text-transform: uppercase;
    font-weight: 500;
  }
  .success__q {
    padding-top: 18px;
    border-top: 1px solid var(--border);
    margin-bottom: 14px !important;
  }
  .chips {
    margin-bottom: 18px;
  }
  .chips__q {
    display: block;
    font-weight: 500;
    font-size: 0.9375rem;
    margin-bottom: 8px;
  }
  .chips__set {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid #484f58;
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    font: 500 0.875rem/1 var(--mono);
    cursor: pointer;
    transition: background-color 120ms, color 120ms, border-color 120ms;
  }
  .chip:hover {
    border-color: var(--lime);
  }
  .chip[aria-pressed='true'] {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--on-lime);
  }
  .success__survey {
    padding-top: 18px;
    border-top: 1px solid var(--border);
    margin-top: 6px !important;
  }
</style>
