---
import { url } from '../lib';
import { form } from '../data/shared';
interface Props {
  id: 'hero' | 'join';
}
const { id } = Astro.props;
---

<div class="signup card" id={`signup-${id}`} data-signup={id}>
  <form class="signup__form" method="post" action="#" novalidate>
    <label class="mono field-label" for={`email-${id}`}>{form.label}</label>
    <div class="signup__row">
      <input
        class="input"
        id={`email-${id}`}
        type="email"
        name="email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder="you@example.com"
        aria-describedby={`email-err-${id} email-micro-${id}`}
      />
      <button class="btn btn--green" type="submit">{form.button}</button>
    </div>
    <div class="hp" aria-hidden="true">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <p class="field-error mono" id={`email-err-${id}`} data-error="invalid" hidden>
      {form.error}
    </p>
    <p class="field-error mono" data-error="failed" role="alert" hidden>
      That didn't go through. Please try again, or email <a href="mailto:alexey@datatalks.club">alexey@datatalks.club</a> and I'll add you.
    </p>
    <p class="micro mono" id={`email-micro-${id}`}>
      {form.micro} <a href={url('/privacy/')}>Privacy</a>
    </p>
  </form>

  <div class="success" data-success hidden>
    <p class="mono label-green">You're on the shortlist</p>
    <h3 class="success__title" tabindex="-1" data-success-title>
      Thank you. I'll write to you before applications open.
    </h3>
    <p>
      Joining the shortlist is not a seat and not a funding decision. It means you hear first, and your choice of track counts when I decide which one runs in April 2027.
    </p>

    <p class="mono label-green success__q">Two quick questions (optional)</p>
    <div class="chips" role="group" aria-label="Where are you based?">
      <span class="chips__q">Where are you based?</span>
      <span class="chips__set">
        <button type="button" class="chip" data-group="location" data-value="berlin" aria-pressed="false">Berlin</button>
        <button type="button" class="chip" data-group="location" data-value="germany" aria-pressed="false">Elsewhere in Germany</button>
        <button type="button" class="chip" data-group="location" data-value="outside-germany" aria-pressed="false">Outside Germany</button>
      </span>
    </div>
    <div class="chips" role="group" aria-label="How would you pay?">
      <span class="chips__q">How would you pay?</span>
      <span class="chips__set">
        <button type="button" class="chip" data-group="funding" data-value="bildungsgutschein" aria-pressed="false">Bildungsgutschein</button>
        <button type="button" class="chip" data-group="funding" data-value="self" aria-pressed="false">Myself</button>
        <button type="button" class="chip" data-group="funding" data-value="employer" aria-pressed="false">My employer</button>
        <button type="button" class="chip" data-group="funding" data-value="unsure" aria-pressed="false">Not sure yet</button>
      </span>
    </div>

    <p class="success__survey">Want more say in what is taught? The five-minute survey decides the curriculum.</p>
    <a class="btn btn--outline" href="#" target="_blank" rel="noopener" data-survey>Take the survey</a>
  </div>
</div>

<style>
  .signup {
    --focus: var(--green-700);
    background: var(--paper);
    color: var(--ink);
    border-radius: 2px;
    padding: 22px 20px 20px;
    box-shadow: 0 18px 48px -18px rgba(0, 0, 0, 0.45);
  }
  @media (min-width: 768px) {
    .signup {
      padding: 28px 28px 24px;
    }
  }
  .field-label {
    display: block;
    margin-bottom: 8px;
    color: var(--ink-2);
    text-transform: uppercase;
  }
  .signup__row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  @media (min-width: 560px) {
    .signup__row {
      flex-direction: row;
    }
    .signup__row .input {
      flex: 1;
      min-width: 0;
    }
  }
  .input {
    width: 100%;
    min-height: 52px;
    padding: 0 14px;
    border: 1px solid rgba(23, 32, 27, 0.5);
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
    font: 400 1rem/1.2 var(--sans);
  }
  .input::placeholder {
    color: #6b756f;
  }
  .input[aria-invalid='true'] {
    border-color: var(--error);
    box-shadow: inset 0 0 0 1px var(--error);
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .field-error {
    margin: 10px 0 0;
    color: var(--error);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .field-error a {
    color: inherit;
    text-decoration: underline;
  }
  .micro {
    margin: 14px 0 0;
    color: var(--ink-2);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .micro a {
    color: var(--green-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .success__title {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.6vw, 1.9rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 8px 0 14px;
    outline: none;
  }
  .success > p:not(.mono) {
    margin: 0 0 20px;
    font-size: 0.96875rem;
  }
  .label-green {
    margin: 0;
    color: var(--green-700);
    text-transform: uppercase;
    font-weight: 500;
  }
  .success__q {
    padding-top: 18px;
    border-top: 1px solid var(--line);
    margin-bottom: 14px !important;
  }
  .chips {
    margin-bottom: 18px;
  }
  .chips__q {
    display: block;
    font-weight: 500;
    font-size: 0.9375rem;
    margin-bottom: 8px;
  }
  .chips__set {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid rgba(23, 32, 27, 0.5);
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    font: 500 0.9375rem/1 var(--sans);
    cursor: pointer;
    transition: background-color 120ms, color 120ms;
  }
  .chip:hover {
    background: var(--mint-100);
  }
  .chip[aria-pressed='true'] {
    background: var(--green-700);
    border-color: var(--green-700);
    color: var(--paper);
  }
  .success__survey {
    padding-top: 18px;
    border-top: 1px solid var(--line);
    margin-top: 6px !important;
  }
</style>
