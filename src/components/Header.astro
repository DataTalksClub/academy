---
import { url } from '../lib';
interface Props {
  cta?: boolean;
  tagline?: boolean;
}
const { cta = false, tagline = true } = Astro.props;
---

<header class="site-header dark">
  <div class="wrap site-header__row">
    <a class="brand" href={url('/')} aria-label="DataTalks.Club Academy, home">
      <img class="brand__logo" src={url('/dtc-logo-white.svg')} alt="" width="92" height="32" />
      <span class="brand__name">Academy</span>
    </a>
    {
      tagline && (
        <p class="site-header__tag mono">First cohort, April 2027</p>
      )
    }
    {
      cta && (
        <a class="btn btn--mint btn--sm" href="#signup-hero" data-scroll-to-form>
          Join the shortlist
        </a>
      )
    }
  </div>
</header>

<style>
  .site-header {
    position: relative;
    background: var(--bg-deep);
    color: var(--fg);
    border-bottom: 1px solid var(--border);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--fg);
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
  }
  .brand__logo {
    display: block;
    height: 30px;
    width: auto;
  }
  .brand__name {
    padding-left: 14px;
    border-left: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 30px;
    color: var(--lime);
  }
  .site-header__tag {
    display: none;
    margin: 0;
    color: var(--muted);
  }
  .site-header__tag::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 3px rgba(198, 244, 50, 0.18);
    vertical-align: 1px;
  }
  @media (min-width: 768px) {
    .site-header__tag {
      display: block;
    }
  }
  .btn--sm {
    min-height: 40px;
    padding: 0 16px;
    font-size: 0.8125rem;
  }
  @media (max-width: 767px) {
    .btn--sm {
      display: none;
    }
  }
</style>
