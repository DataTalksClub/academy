---
import { url } from '../lib';
interface Props {
  cta?: boolean;
  tagline?: boolean;
}
const { cta = false, tagline = true } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a class="brand" href={url('/')} aria-label="DataTalks.Club Academy, home">
      <img class="brand__logo" src={url('/dtc-logo.svg')} alt="" width="92" height="32" />
      <span class="brand__name">Academy</span>
    </a>
    {
      tagline && (
        <p class="site-header__tag mono">First cohort, April 2027</p>
      )
    }
    {
      cta && (
        <a class="btn btn--mint btn--sm" href="#signup-hero" data-scroll-to-form>
          Join the shortlist
        </a>
      )
    }
  </div>
</header>

<style>
  .site-header {
    background: var(--white);
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
  }
  .brand__logo {
    display: block;
    height: 32px;
    width: auto;
  }
  .brand__name {
    padding-left: 14px;
    border-left: 1px solid var(--ink);
    font-family: var(--sans);
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 32px;
  }
  .site-header__tag {
    display: none;
    margin: 0;
    color: var(--ink);
  }
  @media (min-width: 768px) {
    .site-header__row {
      min-height: 84px;
    }
    .brand__logo {
      height: 38px;
    }
    .brand__name {
      font-size: 1.625rem;
      line-height: 38px;
    }
    .site-header__tag {
      display: block;
      text-transform: uppercase;
    }
  }
  .btn--sm {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9375rem;
  }
  @media (max-width: 767px) {
    .btn--sm {
      display: none;
    }
  }
</style>
