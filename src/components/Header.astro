---
import { url } from '../lib';
interface Props {
  cta?: boolean;
  tagline?: boolean;
}
const { cta = false, tagline = true } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a class="brand" href={url('/')} aria-label="DataTalks.Club Academy, home">
      <img src={url('/dtc-logo.svg')} alt="" width="95" height="33" />
      <span class="brand__name">Academy</span>
    </a>
    {
      tagline && (
        <p class="site-header__tag mono">First cohort, April 2027</p>
      )
    }
    {
      cta && (
        <a class="btn btn--mint btn--sm" href="#signup-hero" data-scroll-to-form>
          Join the shortlist
        </a>
      )
    }
  </div>
</header>

<style>
  .site-header {
    background: var(--paper);
    color: var(--navy);
    border-bottom: 1px solid var(--line-strong);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--navy);
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
  }
  .brand img {
    display: block;
    height: 32px;
    width: auto;
  }
  .brand__name {
    padding-left: 14px;
    border-left: 1px solid var(--line-strong);
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1;
    padding-block: 3px;
  }
  .site-header__tag {
    display: none;
    margin: 0;
    color: var(--ink-2);
    text-transform: uppercase;
  }
  .site-header__tag::before {
    content: '';
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 10px;
    border-radius: 50%;
    background: var(--orange);
    vertical-align: 0;
  }
  @media (min-width: 768px) {
    .site-header__tag {
      display: block;
    }
  }
  .btn--sm {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9375rem;
  }
  @media (max-width: 767px) {
    .btn--sm {
      display: none;
    }
    .brand img {
      height: 28px;
    }
    .brand__name {
      font-size: 1.4rem;
    }
  }
</style>
