---
import { url } from '../lib';
interface Props {
  cta?: boolean;
  tagline?: boolean;
}
const { cta = true, tagline = true } = Astro.props;
const onProgram = /\/(agentic-engineering|ai-engineering)\/$/.test(Astro.url.pathname);
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a class="brand" href={url('/')} aria-label="DataTalks.Club Academy, home">
      <img src={url('/dtc-logo.svg')} alt="" width="103" height="36" />
      <span class="brand__name">Academy</span>
    </a>
    {
      tagline && (
        <p class="site-header__tag mono">Live courses for experienced developers</p>
      )
    }
    {
      cta && (
        <a class="btn btn--mint btn--sm" href={onProgram ? '#signup-hero' : url('/#signup-hero')} data-scroll-to-form={onProgram || undefined}>
          Join the Waitlist
        </a>
      )
    }
  </div>
</header>

<style>
  .site-header {
    background: var(--cream);
    color: var(--black);
    border-bottom: var(--border);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--black);
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
  }
  .brand img {
    display: block;
    height: 32px;
    width: auto;
  }
  .brand__name {
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    padding: 7px 12px 8px;
    background: var(--yellow);
    border: var(--border);
    border-radius: 999px;
  }
  .site-header__tag {
    display: none;
    margin: 0;
    padding: 6px 12px;
    background: var(--white);
    border: var(--border);
    border-radius: 8px;
    color: var(--black);
    font-weight: 700;
  }
  @media (min-width: 768px) {
    .brand img {
      height: 38px;
    }
    .brand__name {
      font-size: 1.375rem;
    }
    .site-header__tag {
      display: block;
      text-transform: uppercase;
    }
  }
  .btn--sm {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9375rem;
  }
  @media (max-width: 767px) {
    .btn--sm { padding: 0 8px; font-size: 0.75rem; }
  }
</style>
