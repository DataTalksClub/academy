---
import { url } from '../lib';
interface Props {
  cta?: boolean;
  tagline?: boolean;
}
const { cta = false, tagline = true } = Astro.props;
---

<header class="site-header dark">
  <div class="wrap site-header__row">
    <a class="brand" href={url('/')} aria-label="DataTalks.Club Academy, home">
      <img src={url('/logo.svg')} alt="" width="32" height="32" />
      <span class="brand__name">Academy</span>
    </a>
    {
      tagline && (
        <p class="site-header__tag mono">First cohort · April 2027</p>
      )
    }
    {
      cta && (
        <a class="btn btn--mint btn--sm" href="#signup-hero" data-scroll-to-form>
          Join the shortlist
        </a>
      )
    }
  </div>
</header>

<style>
  .site-header {
    background: var(--green-900);
    color: var(--paper);
    border-bottom: 1px solid var(--line-dark);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: 68px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--paper);
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
  }
  .brand img {
    display: block;
    border-radius: 2px;
  }
  .brand__name {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .site-header__tag {
    display: none;
    margin: 0;
    color: rgba(245, 241, 232, 0.72);
  }
  @media (min-width: 768px) {
    .site-header__tag {
      display: block;
      text-transform: uppercase;
    }
  }
  .btn--sm {
    min-height: 44px;
    padding: 0 16px;
    font-size: 0.9375rem;
  }
  @media (max-width: 767px) {
    .btn--sm {
      display: none;
    }
  }
</style>
