---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SeatGrid from './SeatGrid.astro';
import SignupForm from './SignupForm.astro';
import { emph } from '../lib';
import { heroHonesty, heroInstructorLine, seatCaption } from '../data/shared';

interface Props {
  eyebrow: string;
  headline: string;
  emphasis: string;
  lead: string;
  form?: boolean;
}
const { eyebrow, headline, emphasis, lead, form = true } = Astro.props;
---

<section id="hero" class="hero dark" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__left">
      <div class="hero__copy">
        <p class="mono eyebrow">{eyebrow}</p>
        <h1 id="hero-title" set:html={emph(headline, emphasis)} />
        <p class="lead">{lead}</p>
      </div>

      {
        form && (
          <div class="hero__form">
            <SignupForm id="hero" />
            <p class="mono hero__honesty">{heroHonesty}</p>
          </div>
        )
      }

      {
        form && (
          <p class="hero__instructor">
            <Image src={photo} alt="" width={96} height={96} densities={[1, 2]} class="avatar" />
            <span>{heroInstructorLine}</span>
          </p>
        )
      }
    </div>

    <div class="hero__seats">
      <div class="geo" aria-hidden="true">
        <span class="geo__circle"></span>
        <span class="geo__quarter"></span>
        <span class="geo__half"></span>
        <span class="geo__bar geo__bar--h"></span>
        <span class="geo__bar geo__bar--v"></span>
        <span class="geo__dot"></span>
      </div>
      <div class="hero__panel">
        <div class="hero__seats-lg"><SeatGrid size="lg" numbered /></div>
        <div class="hero__seats-sm"><SeatGrid size="sm" /></div>
        <p class="mono caption">{seatCaption}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--navy);
    color: var(--on-navy);
    padding-block: 44px 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .hero__left {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-bottom: 48px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 24px;
    color: var(--orange);
    text-transform: uppercase;
  }
  .eyebrow::before {
    content: '';
    flex: none;
    width: 28px;
    height: 2px;
    background: var(--orange);
  }
  h1 {
    margin: 0;
    max-width: 13ch;
    font-size: clamp(2.7rem, 4.7vw, 4.6rem);
    line-height: 0.98;
    color: var(--white);
  }
  h1 :global(em) {
    color: var(--orange);
  }
  .lead {
    margin: 28px 0 0;
    max-width: 33rem;
    font-size: 1.0625rem;
    line-height: 1.62;
    color: var(--on-navy-2);
  }
  .hero__form :global(.signup) {
    border-top: 4px solid var(--orange);
  }
  .hero__honesty {
    margin: 14px 0 0;
    color: var(--orange);
    font-size: 0.75rem;
    line-height: 1.6;
    max-width: 34rem;
  }
  .hero__instructor {
    display: flex;
    gap: 16px;
    align-items: center;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid var(--line-dark);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--on-navy-2);
    max-width: 34rem;
  }
  .hero__instructor :global(.avatar) {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    box-shadow: 0 0 0 3px var(--navy), 0 0 0 5px var(--orange);
  }

  /* Right half: off-white field with geometric composition */
  .hero__seats {
    --seat: var(--navy);
    position: relative;
    margin-inline: calc(var(--gutter) * -1);
    padding: 28px var(--gutter);
    min-height: 210px;
    background: var(--paper);
    color: var(--navy);
    overflow: hidden;
    border-top: 1px solid var(--line-strong);
  }
  .geo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .geo > span {
    position: absolute;
    display: block;
  }
  .geo__circle {
    width: 150px;
    height: 150px;
    right: -30px;
    top: 18px;
    border-radius: 50%;
    background: var(--orange);
  }
  .geo__quarter {
    width: 96px;
    height: 96px;
    right: 0;
    bottom: 0;
    background: var(--navy);
    border-radius: 96px 0 0 0;
  }
  .geo__half {
    width: 72px;
    height: 36px;
    right: 132px;
    bottom: 0;
    background: var(--blue);
    border-radius: 72px 72px 0 0;
  }
  .geo__bar--h {
    height: 10px;
    left: 0;
    right: 40%;
    bottom: 0;
    background: var(--navy);
  }
  .geo__bar--v {
    width: 10px;
    top: 0;
    height: 64px;
    right: 150px;
    background: var(--blue);
  }
  .geo__dot {
    width: 18px;
    height: 18px;
    right: 112px;
    top: 104px;
    border-radius: 50%;
    border: 3px solid var(--navy);
  }
  .hero__panel {
    position: relative;
    width: fit-content;
    max-width: 62%;
    padding: 18px;
    background: var(--white);
    border: 1px solid var(--navy);
  }
  /* Calm, static seat plan in the hero (no draw-in animation) */
  .hero__panel :global(rect),
  .hero__panel :global(text) {
    animation: none;
  }
  .hero__seats-lg {
    display: none;
  }
  .hero__seats-sm {
    width: 132px;
  }
  .caption {
    margin: 12px 0 0;
    max-width: 18rem;
    color: var(--navy);
    font-size: 0.6875rem;
    text-transform: none;
  }

  @media (min-width: 900px) {
    .hero {
      padding-block: 0;
      background: linear-gradient(90deg, var(--navy) 0 50%, var(--paper) 50% 100%);
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      min-height: 600px;
    }
    .hero__left {
      justify-content: center;
      gap: 40px;
      padding: 88px 72px 96px 0;
    }
    .hero__seats {
      margin: 0;
      padding: 0;
      min-height: 100%;
      border-top: 0;
      overflow: visible;
    }
    .geo__circle {
      width: min(380px, 70%);
      height: auto;
      aspect-ratio: 1;
      right: 0;
      top: 64px;
    }
    .geo__quarter {
      width: 220px;
      height: 220px;
      right: 0;
      bottom: 0;
      border-radius: 220px 0 0 0;
    }
    .geo__half {
      width: 160px;
      height: 80px;
      right: 260px;
      bottom: 0;
      border-radius: 160px 160px 0 0;
    }
    .geo__bar--h {
      height: 14px;
      left: 0;
      right: 236px;
      bottom: 120px;
    }
    .geo__bar--v {
      width: 14px;
      top: 0;
      height: 180px;
      right: auto;
      left: 72px;
    }
    .geo__dot {
      width: 34px;
      height: 34px;
      right: auto;
      left: 120px;
      top: 64px;
      border-width: 4px;
    }
    .hero__panel {
      position: absolute;
      left: 72px;
      top: 50%;
      transform: translateY(-50%);
      width: min(360px, calc(100% - 120px));
      max-width: none;
      padding: 24px;
    }
    .hero__seats-lg {
      display: block;
    }
    .hero__seats-sm {
      display: none;
    }
    .caption {
      margin-top: 18px;
      font-size: 0.75rem;
    }
  }
</style>
