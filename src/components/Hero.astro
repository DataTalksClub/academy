---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SeatGrid from './SeatGrid.astro';
import SignupForm from './SignupForm.astro';
import { emph } from '../lib';
import { heroHonesty, heroInstructorLine, seatCaption } from '../data/shared';

interface Props {
  eyebrow: string;
  headline: string;
  emphasis: string;
  lead: string;
  form?: boolean;
}
const { eyebrow, headline, emphasis, lead, form = true } = Astro.props;
---

<section id="hero" class={`hero ${form ? 'hero--form' : 'hero--plain'}`} aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__mast">
      <p class="mono eyebrow">{eyebrow}</p>
      <h1 id="hero-title" set:html={emph(headline, emphasis)} />
    </div>
    <p class="lead">{lead}</p>

    {
      form && (
        <div class="hero__form">
          <SignupForm id="hero" />
          <p class="mono hero__honesty">{heroHonesty}</p>
        </div>
      )
    }

    <div class="hero__aside">
      {
        form && (
          <p class="hero__instructor">
            <Image src={photo} alt="" width={240} height={240} densities={[1, 2]} class="avatar" />
            <span>{heroInstructorLine}</span>
          </p>
        )
      }

      <div class="hero__seats">
        <div class="hero__seats-lg"><SeatGrid size="lg" numbered /></div>
        <div class="hero__seats-sm"><SeatGrid size="sm" /></div>
        <p class="mono caption">{seatCaption}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --seat: var(--red);
    background: var(--paper);
    color: var(--ink);
    padding-block: 28px 64px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }
  .hero__mast {
    border-top: 3px double var(--rule);
    border-bottom: 3px double var(--rule);
    padding: 18px 0 30px;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 22px;
    color: var(--red-ink);
    text-transform: uppercase;
  }
  h1 {
    margin: 0 auto;
    max-width: 15ch;
  }
  .lead {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .hero--plain .lead::first-line {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }
  .hero--form .lead::first-letter {
    float: left;
    margin: 0.06em 0.1em 0 0;
    font-family: var(--display);
    font-size: 4.6em;
    line-height: 0.78;
    color: var(--red);
  }
  .hero__seats-lg {
    display: none;
  }
  .hero__seats-sm {
    max-width: 150px;
  }
  .caption {
    margin: 14px 0 0;
    color: var(--red-ink);
    text-transform: uppercase;
  }
  .hero__honesty {
    margin: 14px 0 0;
    color: var(--ink-2);
    font-weight: 500;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    line-height: 1.6;
    max-width: 36rem;
  }
  .hero__instructor {
    display: flex;
    gap: 16px;
    align-items: flex-end;
    margin: 0 0 32px;
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .hero__instructor :global(.avatar) {
    flex: none;
    width: 96px;
    height: 128px;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.1);
  }
  .hero__form :global(.signup) {
    box-shadow: none;
    border: 1px solid var(--rule);
    background: #fff;
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: 40px 112px;
    }
    .hero__mast {
      padding: 22px 0 48px;
    }
    .eyebrow {
      margin-bottom: 36px;
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 28px;
      row-gap: 48px;
      grid-template-areas:
        'mast mast mast mast mast mast mast mast mast mast mast mast'
        'lead lead lead lead lead lead lead lead . aside aside aside'
        'form form form form form form form form . aside aside aside';
    }
    .hero--plain .hero__grid {
      grid-template-areas:
        'mast mast mast mast mast mast mast mast mast mast mast mast'
        'lead lead lead lead lead lead lead lead . aside aside aside';
    }
    .hero__mast {
      grid-area: mast;
    }
    .lead {
      grid-area: lead;
      align-self: start;
      font-size: 1.25rem;
      line-height: 1.55;
    }
    .hero__form {
      grid-area: form;
      align-self: start;
    }
    .hero__aside {
      grid-area: aside;
      padding-left: 28px;
      border-left: 1px solid var(--rule);
    }
    .hero__instructor {
      display: block;
    }
    .hero__instructor :global(.avatar) {
      display: block;
      width: 100%;
      max-width: 240px;
      height: auto;
      aspect-ratio: 3 / 4;
      margin-bottom: 14px;
    }
    .hero__seats-lg {
      display: block;
      max-width: 260px;
    }
    .hero__seats-sm {
      display: none;
    }
    .caption {
      margin-top: 18px;
    }
  }
  @media (min-width: 1024px) {
    .lead {
      column-count: 2;
      column-gap: 40px;
      column-rule: 1px solid var(--line);
    }
  }
</style>
