---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SeatGrid from './SeatGrid.astro';
import SignupForm from './SignupForm.astro';
import { emph } from '../lib';
import { heroHonesty, heroInstructorLine, seatCaption } from '../data/shared';

interface Props {
  eyebrow: string;
  headline: string;
  emphasis: string;
  lead: string;
  basis?: string;
  links?: { label: string; href: string }[];
  form?: boolean;
  chooseProgram?: boolean;
}
const { eyebrow, headline, emphasis, lead, basis, links, form = true, chooseProgram = false } = Astro.props;
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="mono eyebrow">{eyebrow}</p>
      <h1 id="hero-title" set:html={emph(headline, emphasis)} />
      <p class="lead">{lead}</p>
      {basis && <p class="hero__basis">{basis}</p>}
      {links && links.length > 0 && (
        <p class="hero__links mono">
          {links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </p>
      )}
    </div>

    {
      form && (
        <div class="hero__form">
          <SignupForm id="hero" chooseProgram={chooseProgram} />
          <p class="mono hero__honesty">{heroHonesty}</p>
        </div>
      )
    }

    {
      form && (
        <p class="hero__instructor">
          <Image src={photo} alt="" width={96} height={96} densities={[1, 2]} class="avatar" />
          <span>{heroInstructorLine}</span>
        </p>
      )
    }

    <div class="hero__seats">
      <div class="hero__seats-lg"><SeatGrid size="lg" numbered /></div>
      <div class="hero__seats-sm"><SeatGrid size="sm" /></div>
      <p class="mono caption">{seatCaption}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    --focus: var(--black);
    position: relative;
    background: var(--yellow);
    color: var(--black);
    padding-block: 40px 56px;
    border-bottom: var(--border);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .eyebrow {
    display: inline-block;
    margin: 0 0 22px;
    padding: 6px 12px;
    background: var(--black);
    color: var(--yellow);
    border-radius: 999px;
    text-transform: uppercase;
    font-weight: 700;
  }
  h1 {
    margin: 0;
    max-width: 15ch;
    line-height: 1;
    text-wrap: wrap;
  }
  h1::first-line {
    background: var(--black);
    color: var(--white);
  }
  h1 :global(em) {
    background: var(--black);
    color: var(--white);
    padding: 0 0.14em 0.04em;
    margin: 0 -0.04em;
    border-radius: 0.12em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .lead {
    margin: 28px 0 0;
    max-width: 36rem;
    padding: 18px 20px;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--black);
  }
  .hero__basis {
    margin: 16px 0 0;
    max-width: 36rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    font-weight: 500;
    color: var(--black);
  }
  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin: 16px 0 0;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.6;
  }
  .hero__links a {
    color: var(--black);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .hero__form :global(.signup) {
    box-shadow: var(--shadow);
  }
  .hero__seats-lg {
    display: none;
  }
  .hero__seats-sm {
    max-width: 160px;
  }
  .caption {
    display: inline-block;
    margin: 18px 0 0;
    padding: 8px 14px;
    background: var(--white);
    border: var(--border);
    border-radius: 8px;
    box-shadow: var(--shadow-sm);
    color: var(--black);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: none;
    transform: rotate(-2deg);
  }
  .hero__honesty {
    margin: 14px 0 0;
    color: var(--black);
    font-size: 0.75rem;
    line-height: 1.6;
    max-width: 34rem;
  }
  .hero__instructor {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 4px 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    font-weight: 500;
    color: var(--black);
    max-width: 34rem;
  }
  .hero__instructor :global(.avatar) {
    flex: none;
    width: 56px;
    height: 56px;
    border: var(--border);
    border-radius: 50%;
    object-fit: cover;
    background: var(--coral);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: 72px 104px;
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 0;
      grid-template-areas:
        'copy copy copy copy copy copy copy copy seats seats seats seats'
        'form form form form form form form . seats seats seats seats'
        'inst inst inst inst inst inst inst . seats seats seats seats';
    }
    .hero__copy {
      grid-area: copy;
    }
    .hero__seats {
      grid-area: seats;
      align-self: center;
      justify-self: end;
      width: 100%;
      text-align: right;
    }
    .hero__form {
      grid-area: form;
      margin-top: 44px;
    }
    .hero__instructor {
      grid-area: inst;
      margin-top: 32px;
    }
    .hero__seats-lg {
      display: block;
    }
    .hero__seats-sm {
      display: none;
    }
    .caption {
      margin-top: 28px;
      font-size: 0.8125rem;
    }
  }
</style>
