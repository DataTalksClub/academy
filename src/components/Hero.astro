---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SeatGrid from './SeatGrid.astro';
import SignupForm from './SignupForm.astro';
import { emph } from '../lib';
import { heroHonesty, heroInstructorLine, seatCaption } from '../data/shared';

interface Props {
  eyebrow: string;
  headline: string;
  emphasis: string;
  lead: string;
  form?: boolean;
}
const { eyebrow, headline, emphasis, lead, form = true } = Astro.props;
---

<section id="hero" class="hero dark" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="mono eyebrow">{eyebrow}</p>
      <h1 id="hero-title" set:html={emph(headline, emphasis)} />
      <p class="lead">{lead}</p>
    </div>

    {
      form && (
        <div class="hero__form">
          <SignupForm id="hero" />
          <p class="mono hero__honesty">{heroHonesty}</p>
        </div>
      )
    }

    {
      form && (
        <p class="hero__instructor">
          <Image src={photo} alt="" width={96} height={96} densities={[1, 2]} class="avatar" />
          <span>{heroInstructorLine}</span>
        </p>
      )
    }

    <div class="hero__seats">
      <div class="hero__seats-lg"><SeatGrid size="lg" numbered /></div>
      <div class="hero__seats-sm"><SeatGrid size="sm" /></div>
      <p class="mono caption">{seatCaption}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      linear-gradient(180deg, rgba(1, 4, 9, 0) 60%, var(--bg) 100%),
      var(--dots),
      var(--bg-deep);
    color: var(--fg);
    padding-block: 48px 56px;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      180deg,
      rgba(230, 237, 243, 0.018) 0 1px,
      transparent 1px 4px
    );
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--muted);
    font-size: 0.75rem;
  }
  .eyebrow::before {
    content: '$';
    color: var(--lime);
    font-weight: 700;
  }
  h1 {
    margin: 0;
    max-width: 15ch;
  }
  h1::after {
    content: '';
    display: inline-block;
    width: 0.42em;
    height: 0.78em;
    margin-left: 0.12em;
    vertical-align: -0.04em;
    background: var(--lime);
    animation: blink 1.1s steps(1) 2s infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    h1::after {
      animation: none;
    }
  }
  .lead {
    margin: 28px 0 0;
    padding-left: 18px;
    border-left: 2px solid var(--border);
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #c9d1d9;
  }
  .hero__seats {
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    max-width: 260px;
  }
  .hero__seats-lg {
    display: none;
  }
  .hero__seats-sm {
    max-width: 150px;
  }
  .caption {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.75rem;
  }
  .caption::before {
    content: '// ';
    color: var(--lime);
  }
  .hero__honesty {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.65;
    max-width: 36rem;
  }
  .hero__instructor {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 4px 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--muted);
    max-width: 36rem;
  }
  .hero__instructor :global(.avatar) {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: 88px 112px;
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 0;
      grid-template-areas:
        'copy copy copy copy copy copy copy copy seats seats seats seats'
        'form form form form form form form . seats seats seats seats'
        'inst inst inst inst inst inst inst . seats seats seats seats';
    }
    .hero__copy {
      grid-area: copy;
    }
    .hero__seats {
      grid-area: seats;
      align-self: start;
      justify-self: end;
      width: 100%;
      max-width: none;
      padding: 22px;
      margin-top: 8px;
    }
    .hero__form {
      grid-area: form;
      margin-top: 44px;
    }
    .hero__instructor {
      grid-area: inst;
      margin-top: 28px;
    }
    .hero__seats-lg {
      display: block;
    }
    .hero__seats-sm {
      display: none;
    }
    .caption {
      margin-top: 18px;
      font-size: 0.75rem;
    }
  }
</style>
