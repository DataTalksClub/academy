---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SeatGrid from './SeatGrid.astro';
import SignupForm from './SignupForm.astro';
import { emph } from '../lib';
import { heroHonesty, heroInstructorLine, seatCaption } from '../data/shared';

interface Props {
  eyebrow: string;
  headline: string;
  emphasis: string;
  lead: string;
  form?: boolean;
}
const { eyebrow, headline, emphasis, lead, form = true } = Astro.props;
---

<section id="hero" class={`hero ${form ? 'hero--form' : 'hero--plain'}`} aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__head">
      <p class="mono eyebrow">{eyebrow}</p>
      <h1 id="hero-title" set:html={emph(headline, emphasis)} />
    </div>

    <div class="hero__rule" aria-hidden="true"></div>

    <p class="lead">{lead}</p>

    {
      form && (
        <div class="hero__form">
          <SignupForm id="hero" />
          <p class="mono hero__honesty">{heroHonesty}</p>
        </div>
      )
    }

    {
      form && (
        <p class="hero__instructor">
          <Image src={photo} alt="" width={96} height={96} densities={[1, 2]} class="avatar" />
          <span>{heroInstructorLine}</span>
        </p>
      )
    }

    <div class="hero__seats">
      <div class="hero__seats-lg"><SeatGrid size="lg" numbered /></div>
      <div class="hero__seats-sm"><SeatGrid size="sm" /></div>
      <p class="mono caption">{seatCaption}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    --seat: var(--blue);
    background: var(--white);
    color: var(--ink);
    padding-block: 28px 56px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .eyebrow {
    margin: 0 0 28px;
    color: var(--ink);
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
  }
  .hero__rule {
    height: 10px;
    background: var(--blue);
  }
  .lead {
    margin: 0;
    max-width: 36rem;
    font-size: 1.1875rem;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--ink);
  }
  .hero__seats-lg {
    display: none;
  }
  .hero__seats-sm {
    max-width: 150px;
  }
  .caption {
    margin: 14px 0 0;
    color: var(--ink);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }
  .hero__honesty {
    margin: 12px 0 0;
    color: var(--ink-2);
    font-size: 0.75rem;
    line-height: 1.6;
    max-width: 36rem;
  }
  .hero__instructor {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 0;
    padding-top: 20px;
    border-top: 1px solid var(--ink);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink);
    max-width: 36rem;
  }
  .hero__instructor :global(.avatar) {
    flex: none;
    width: 56px;
    height: 56px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: 40px 96px;
    }
    /* Visible 12-column grid: faint column guides behind the hero. */
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      row-gap: 0;
      background-image: linear-gradient(to right, #ebebed 1px, transparent 1px);
      background-size: calc((100% + var(--col-gap)) / 12) 100%;
      background-origin: content-box;
      background-clip: content-box;
      background-repeat: repeat-x;
    }
    .hero__head {
      grid-column: 1 / span 10;
      grid-row: 1;
      padding-bottom: 56px;
    }
    .eyebrow {
      margin-bottom: 48px;
    }
    .hero__rule {
      grid-column: 1 / -1;
      grid-row: 2;
      height: 14px;
    }
    .lead {
      grid-column: 7 / span 6;
      grid-row: 3;
      margin-top: 40px;
      font-size: 1.3125rem;
    }
    .hero__form {
      grid-column: 7 / span 6;
      grid-row: 4;
      margin-top: 40px;
    }
    .hero__instructor {
      grid-column: 7 / span 6;
      grid-row: 5;
      margin-top: 32px;
    }
    .hero__seats {
      grid-column: 1 / span 4;
      grid-row: 3 / span 3;
      align-self: start;
      margin-top: 46px;
      width: 100%;
      max-width: 300px;
    }
    .hero__seats-lg {
      display: block;
    }
    .hero__seats-sm {
      display: none;
    }
    .caption {
      margin-top: 18px;
      font-size: 0.75rem;
    }
  }
</style>
