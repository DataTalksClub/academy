---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SeatGrid from './SeatGrid.astro';
import SignupForm from './SignupForm.astro';
import { emph } from '../lib';
import { heroInstructorLine, seatCaption } from '../data/shared';

interface Props {
  eyebrow: string;
  headline: string;
  emphasis: string;
  lead: string;
  form?: boolean;
}
const { eyebrow, headline, emphasis, lead, form = true } = Astro.props;
---

<section id="hero" class="hero dark" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="mono eyebrow">{eyebrow}</p>
      <h1 id="hero-title" set:html={emph(headline, emphasis)} />
      <p class="lead">{lead}</p>
    </div>

    <div class="hero__seats">
      <div class="hero__seats-lg"><SeatGrid size="lg" numbered /></div>
      <div class="hero__seats-sm"><SeatGrid size="sm" /></div>
      <p class="mono caption">{seatCaption}</p>
    </div>

    {form && <div class="hero__form"><SignupForm id="hero" /></div>}

    {
      form && (
        <p class="hero__instructor">
          <Image src={photo} alt="" width={96} height={96} densities={[1, 2]} class="avatar" />
          <span>{heroInstructorLine}</span>
        </p>
      )
    }
  </div>
</section>

<style>
  .hero {
    background: var(--green-900);
    color: var(--paper);
    padding-block: 40px 56px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .eyebrow {
    margin: 0 0 20px;
    color: var(--mint);
    text-transform: uppercase;
  }
  h1 {
    margin: 0;
    max-width: 14ch;
  }
  h1 :global(em) {
    color: var(--mint);
  }
  .lead {
    margin: 24px 0 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(245, 241, 232, 0.86);
  }
  .hero__seats-lg {
    display: none;
  }
  .hero__seats-sm {
    max-width: 150px;
  }
  .caption {
    margin: 14px 0 0;
    color: var(--mint);
    font-size: 0.6875rem;
    text-transform: none;
  }
  .hero__instructor {
    display: flex;
    gap: 14px;
    align-items: center;
    margin: 4px 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: rgba(245, 241, 232, 0.78);
    max-width: 34rem;
  }
  .hero__instructor :global(.avatar) {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 2px;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: 72px 112px;
    }
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 0;
      grid-template-areas:
        'copy copy copy copy copy copy copy . seats seats seats seats'
        'form form form form form form form . seats seats seats seats'
        'inst inst inst inst inst inst inst . seats seats seats seats';
    }
    .hero__copy {
      grid-area: copy;
    }
    .hero__seats {
      grid-area: seats;
      align-self: center;
      justify-self: end;
      width: 100%;
    }
    .hero__form {
      grid-area: form;
      margin-top: 40px;
    }
    .hero__instructor {
      grid-area: inst;
      margin-top: 28px;
    }
    .hero__seats-lg {
      display: block;
    }
    .hero__seats-sm {
      display: none;
    }
    .caption {
      margin-top: 22px;
      font-size: 0.75rem;
    }
  }
</style>
