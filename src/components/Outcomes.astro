---
import SectionHead from './SectionHead.astro';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
---

<section id="outcomes" class="section" aria-labelledby="outcomes-title">
  <div class="wrap">
    <SectionHead title={track.outcomesTitle} titleId="outcomes-title" />
    <ol class="outcomes">
      {
        track.outcomes.map((o, i) => (
          <li>
            <span class="num mono-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="outcomes__text">{o}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section-head :global(h2) {
    max-width: 24ch;
  }
  .outcomes {
    list-style: none;
    margin: 20px 0 0;
    padding: 10px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }
  li {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 0;
    padding: 10px 16px 10px 0;
  }
  .num {
    padding-right: 12px;
    border-right: 1px solid var(--border);
    text-align: right;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: #7d8590;
  }
  .outcomes__text {
    padding-left: 16px;
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.6;
  }
  li:hover .num {
    color: var(--lime);
  }
  @media (min-width: 768px) {
    .outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 40px;
      padding: 16px 0;
    }
    li {
      grid-template-columns: 4rem minmax(0, 1fr);
      padding: 14px 28px 14px 0;
    }
    li:nth-child(2n) {
      border-left: 1px solid var(--border);
    }
    .outcomes__text {
      padding-left: 20px;
    }
  }
</style>
