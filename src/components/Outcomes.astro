---
import SectionHead from './SectionHead.astro';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
---

<section id="outcomes" class="section" aria-labelledby="outcomes-title">
  <div class="wrap">
    <SectionHead title={track.outcomesTitle} titleId="outcomes-title" />
    <ol class="outcomes">
      {
        track.outcomes.map((o, i) => (
          <li>
            <span class="num mono-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="outcomes__text">{o}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  #outcomes :global(.section-head h2) {
    max-width: 20ch;
    margin: 0 auto;
    text-align: center;
    font-size: clamp(2.4rem, 5.4vw, 4.5rem);
  }
  .outcomes {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 2px solid var(--rule);
  }
  li {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .num {
    font-family: var(--display);
    font-style: italic;
    font-size: 2.25rem;
    line-height: 0.9;
    color: var(--red);
  }
  .outcomes__text {
    max-width: 34rem;
  }
  @media (min-width: 768px) {
    .outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 56px;
      margin-top: 72px;
    }
    li {
      grid-template-columns: 76px minmax(0, 1fr);
      padding: 30px 0;
    }
    .num {
      font-size: 3rem;
    }
  }
</style>
