---
import SectionHead from './SectionHead.astro';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
---

<section id="outcomes" class="section" aria-labelledby="outcomes-title">
  <div class="wrap split">
    <SectionHead title={track.outcomesTitle} titleId="outcomes-title" />
    <ol class="outcomes split__body">
      {
        track.outcomes.map((o, i) => (
          <li>
            <span class="num mono-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="outcomes__text">{o}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .outcomes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 8px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .num {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1;
    color: var(--navy);
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--orange);
  }
  .outcomes__text {
    padding-top: 6px;
    max-width: 34rem;
  }
  @media (min-width: 768px) {
    .outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 40px;
      padding-left: 48px;
    }
    li {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding: 28px 0 32px;
      border-top: 2px solid var(--navy);
    }
    .outcomes__text {
      padding-top: 0;
    }
  }
</style>
