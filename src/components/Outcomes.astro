---
import SectionHead from './SectionHead.astro';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
---

<section id="outcomes" class="section" aria-labelledby="outcomes-title">
  <div class="wrap">
    <SectionHead title={track.outcomesTitle} titleId="outcomes-title" />
    <ol class="outcomes">
      {
        track.outcomes.map((o, i) => (
          <li>
            <span class="num mono-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="outcomes__text">{o}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .section-head :global(h2) {
    max-width: 24ch;
  }
  .outcomes {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-top: 1px solid var(--line);
  }
  li {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 8px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }
  .num {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--green-700);
    letter-spacing: -0.02em;
  }
  .outcomes__text {
    padding-top: 4px;
    max-width: 34rem;
  }
  @media (min-width: 768px) {
    .outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
      margin-top: 36px;
    }
    li {
      grid-template-columns: 72px minmax(0, 1fr);
      padding: 28px 24px 28px 0;
    }
    li:nth-child(2n) {
      padding-left: 0;
    }
    .num {
      font-size: 2rem;
    }
    .outcomes__text {
      padding-top: 8px;
    }
  }
</style>
