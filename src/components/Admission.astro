---
import SectionHead from './SectionHead.astro';
import SeatGrid from './SeatGrid.astro';
import { admission } from '../data/shared';
---

<section id="admission" class="section" aria-labelledby="admission-title">
  <div class="wrap admission">
    <div class="admission__why">
      <SectionHead title={admission.heading} titleId="admission-title" />
      <div class="admission__seats paper-seats"><SeatGrid size="sm" /></div>
      <p class="admission__body">{admission.body}</p>
    </div>
    <ol class="steps">
      {
        admission.steps.map((s, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <p>
              <strong>{s.title}</strong> {s.text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .admission {
    display: grid;
    gap: 48px;
    grid-template-columns: minmax(0, 1fr);
  }
  .paper-seats {
    --seat: var(--lime);
    margin: 28px 0 24px;
    max-width: 150px;
  }
  .admission__body {
    margin: 0;
    max-width: 30rem;
    color: #c9d1d9;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: start;
    display: grid;
    gap: 12px;
  }
  .steps li {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 8px;
    padding: 20px 18px 20px 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .num {
    align-self: start;
    text-align: right;
    padding-right: 12px;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.9;
    color: var(--lime);
  }
  .steps p {
    margin: 0;
    padding-left: 6px;
    max-width: 32rem;
    color: var(--muted);
  }
  .steps strong {
    display: block;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.3125rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
    margin-bottom: 4px;
    color: var(--fg);
  }
  @media (min-width: 768px) {
    .admission {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
    }
    .admission__why {
      grid-column: 1 / span 5;
    }
    .steps {
      grid-column: 7 / span 6;
    }
    .steps li {
      grid-template-columns: 64px minmax(0, 1fr);
    }
  }
</style>
