---
import SectionHead from './SectionHead.astro';
import SeatGrid from './SeatGrid.astro';
import { admission } from '../data/shared';
---

<section id="admission" class="section" aria-labelledby="admission-title">
  <div class="wrap admission">
    <div class="admission__why">
      <SectionHead title={admission.heading} titleId="admission-title" />
      <div class="admission__seats paper-seats"><SeatGrid size="sm" /></div>
      <p class="admission__body">{admission.body}</p>
    </div>
    <ol class="steps">
      {
        admission.steps.map((s, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <p>
              <strong>{s.title}</strong> {s.text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .admission {
    display: grid;
    gap: 48px;
    grid-template-columns: minmax(0, 1fr);
  }
  .paper-seats {
    margin: 28px 0 24px;
    max-width: 150px;
  }
  .admission__body {
    margin: 0;
    max-width: 30rem;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    align-self: start;
  }
  .steps li {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 16px;
    padding: 18px;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  .num {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: var(--border);
    border-radius: 50%;
    background: var(--blue);
    color: var(--white);
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
  }
  .steps li:nth-child(2) .num { background: var(--coral); color: var(--black); }
  .steps li:nth-child(3) .num { background: var(--green); color: var(--black); }
  .steps li:nth-child(4) .num { background: var(--yellow); color: var(--black); }
  .steps p {
    margin: 0;
    padding-top: 2px;
    max-width: 32rem;
  }
  .steps strong {
    display: block;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.3125rem;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 4px;
  }
  @media (min-width: 768px) {
    .admission {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
    }
    .admission__why {
      grid-column: 1 / span 5;
    }
    .steps {
      grid-column: 7 / span 6;
    }
    .steps li {
      grid-template-columns: 64px minmax(0, 1fr);
      padding: 20px 22px;
    }
    .num {
      width: 64px;
      height: 64px;
      font-size: 1.5rem;
    }
  }
</style>
