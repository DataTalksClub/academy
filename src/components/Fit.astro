---
import { fit } from '../data/shared';
import { rich } from '../lib';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
const forItems = [track.fitFirst, ...fit.forShared];
---

<section id="fit" class="section" aria-labelledby="fit-title">
  <div class="wrap">
    <div class="fit">
      <div class="fit__col">
        <h2 id="fit-title" class="h-col">{fit.forTitle}</h2>
        <ul class="ticks ticks--yes">
          {forItems.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="fit__col">
        <h2 class="h-col">{fit.notTitle}</h2>
        <ul class="ticks ticks--no">
          {fit.not.map((t) => <li set:html={rich(t)} />)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .fit {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr);
  }
  .fit__col {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    padding: 24px 20px 10px;
  }
  .fit__col:first-child {
    border-top: 2px solid var(--lime);
  }
  .h-col {
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    margin: 0 0 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ticks li {
    position: relative;
    padding: 0 0 16px 30px;
    max-width: 34rem;
  }
  .ticks li::before {
    position: absolute;
    left: 0;
    top: 0;
    font: 700 1rem/1.65 var(--mono);
  }
  .ticks--yes li::before {
    content: '+';
    color: var(--lime);
  }
  .ticks--no li::before {
    content: '\2212';
    color: #ff7b72;
  }
  .ticks--no li {
    color: #c9d1d9;
  }
  .ticks :global(a) {
    color: var(--cyan);
    text-underline-offset: 3px;
  }
  @media (min-width: 768px) {
    .fit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 28px;
    }
    .fit__col {
      padding: 32px 32px 16px;
    }
  }
</style>
