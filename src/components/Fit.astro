---
import { fit } from '../data/shared';
import { rich } from '../lib';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
const forItems = [track.fitFirst, ...fit.forShared];
---

<section id="fit" class="section" aria-labelledby="fit-title">
  <div class="wrap">
    <div class="fit">
      <div class="fit__col">
        <h2 id="fit-title" class="h-col">{fit.forTitle}</h2>
        <ul class="ticks ticks--yes">
          {forItems.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="fit__col">
        <h2 class="h-col">{fit.notTitle}</h2>
        <ul class="ticks ticks--no">
          {fit.not.map((t) => <li set:html={rich(t)} />)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .fit {
    display: grid;
    gap: 48px;
    grid-template-columns: minmax(0, 1fr);
  }
  .h-col {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin: 0 0 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--ink);
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ticks li {
    position: relative;
    padding: 0 0 18px 28px;
    max-width: 34rem;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 12px;
    height: 12px;
    border: 1.5px solid var(--ink);
  }
  .ticks--yes li::before {
    background: var(--blue);
    border-color: var(--blue);
  }
  .ticks li :global(a) {
    color: var(--blue);
  }
  @media (min-width: 768px) {
    .fit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0;
      margin-top: 8px;
    }
    .fit__col + .fit__col {
      border-left: 1px solid var(--ink);
      padding-left: 48px;
    }
    .fit__col:first-child {
      padding-right: 48px;
    }
  }
</style>
