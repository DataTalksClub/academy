---
import { fit } from '../data/shared';
import { rich } from '../lib';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
const forItems = [track.fitFirst, ...fit.forShared];
---

<section id="fit" class="section" aria-labelledby="fit-title">
  <div class="wrap">
    <div class="fit">
      <div class="fit__col">
        <h2 id="fit-title" class="h-col">{fit.forTitle}</h2>
        <ul class="ticks ticks--yes">
          {forItems.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="fit__col">
        <h2 class="h-col">{fit.notTitle}</h2>
        <ul class="ticks ticks--no">
          {fit.not.map((t) => <li set:html={rich(t)} />)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .fit {
    display: grid;
    gap: 28px;
    grid-template-columns: minmax(0, 1fr);
  }
  .fit__col {
    padding: 24px 20px 10px;
    background: var(--tint-mint);
    border: var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
  }
  .fit__col + .fit__col {
    background: var(--tint-coral);
  }
  .h-col {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    margin: 0 0 22px;
    padding-bottom: 18px;
    border-bottom: var(--border);
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ticks li {
    position: relative;
    padding: 0 0 18px 34px;
    max-width: 34rem;
  }
  .ticks li :global(a) {
    color: var(--black);
    font-weight: 700;
    text-decoration-thickness: 2px;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25em;
    width: 18px;
    height: 18px;
    border: var(--border);
    border-radius: 5px;
    background: var(--white);
  }
  .ticks--yes li::before {
    background: var(--green);
  }
  .ticks--no li::before {
    background: var(--coral);
    border-radius: 50%;
  }
  @media (min-width: 768px) {
    .fit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 36px;
    }
    .fit__col {
      padding: 32px 30px 14px;
    }
  }
</style>
