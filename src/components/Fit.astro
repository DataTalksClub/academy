---
import { fit } from '../data/shared';
import { rich } from '../lib';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
const forItems = [track.fitFirst, ...fit.forShared];
---

<section id="fit" class="section" aria-labelledby="fit-title">
  <div class="wrap">
    <div class="fit">
      <div class="fit__col">
        <h2 id="fit-title" class="h-col">{fit.forTitle}</h2>
        <ul class="ticks ticks--yes">
          {forItems.map((t) => <li>{t}</li>)}
        </ul>
      </div>
      <div class="fit__col">
        <h2 class="h-col">{fit.notTitle}</h2>
        <ul class="ticks ticks--no">
          {fit.not.map((t) => <li set:html={rich(t)} />)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .fit {
    display: grid;
    gap: 56px;
    grid-template-columns: minmax(0, 1fr);
  }
  .h-col {
    font-size: clamp(2rem, 3.6vw, 3rem);
    margin: 0 0 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--rule);
  }
  .fit__col:last-child .h-col {
    font-style: italic;
  }
  .ticks {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ticks li {
    position: relative;
    padding: 0 0 16px 30px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
    max-width: 34rem;
  }
  .ticks li:last-child {
    border-bottom: 0;
  }
  .ticks li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 12px;
    height: 12px;
  }
  .ticks--yes li::before {
    background: var(--red);
    border-radius: 50%;
  }
  .ticks--no li::before {
    top: 0.85em;
    height: 0;
    width: 14px;
    border-top: 2px solid var(--ink);
  }
  .ticks :global(a) {
    color: var(--red-ink);
    text-underline-offset: 3px;
  }
  @media (min-width: 768px) {
    .fit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0;
    }
    .fit__col:first-child {
      padding-right: 56px;
    }
    .fit__col:last-child {
      padding-left: 56px;
      border-left: 1px solid var(--rule);
    }
  }
</style>
