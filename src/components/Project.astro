---
import SectionHead from './SectionHead.astro';
import { project } from '../data/shared';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
---

<section id="project" class="section" aria-labelledby="project-title">
  <div class="wrap split">
    <SectionHead title={project.heading} titleId="project-title" />
    <div class="split__body">
      <p class="project">{track.project}</p>
    </div>
  </div>
</section>

<style>
  .project {
    position: relative;
    margin: 0;
    padding: 32px 0 0 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    line-height: 1.3;
    max-width: 40rem;
  }
  .project::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 96px;
    height: 8px;
    background: linear-gradient(90deg, var(--blue) 0 66%, var(--orange) 66% 100%);
  }
</style>
