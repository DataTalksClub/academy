---
import SectionHead from './SectionHead.astro';
import { project } from '../data/shared';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
---

<section id="project" class="section" aria-labelledby="project-title">
  <div class="wrap split">
    <SectionHead title={project.heading} titleId="project-title" />
    <div class="split__body">
      <p class="project">{track.project}</p>
    </div>
  </div>
</section>

<style>
  .project {
    position: relative;
    margin: 0;
    padding: 24px 22px 24px 26px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--lime);
    border-radius: var(--radius);
    background: var(--panel);
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    max-width: 40rem;
  }
</style>
