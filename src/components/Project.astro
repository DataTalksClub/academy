---
import SectionHead from './SectionHead.astro';
import { project } from '../data/shared';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
---

<section id="project" class="section" aria-labelledby="project-title">
  <div class="wrap split">
    <SectionHead title={project.heading} titleId="project-title" />
    <div class="split__body">
      <p class="project">{track.project}</p>
    </div>
  </div>
</section>

<style>
  .project {
    margin: 0;
    padding-top: 24px;
    border-top: 10px solid var(--blue);
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    line-height: 1.3;
    letter-spacing: -0.025em;
    max-width: 38rem;
  }
</style>
