---
import SignupForm from './SignupForm.astro';
import SeatGrid from './SeatGrid.astro';
import { join, seatCaption } from '../data/shared';
---

<section id="join" class="join dark" aria-labelledby="join-title">
  <div class="wrap join__grid">
    <div class="join__copy">
      <h2 id="join-title">{join.heading}</h2>
      <p class="join__text">{join.text}</p>
      <div class="join__seats"><SeatGrid size="sm" /></div>
      <p class="mono caption">{seatCaption}</p>
    </div>
    <div class="join__form"><SignupForm id="join" /></div>
  </div>
</section>

<style>
  .join {
    --seat: #fff;
    --focus: #fff;
    background: var(--blue);
    color: #fff;
    padding-block: 56px 64px;
  }
  .join__grid {
    display: grid;
    gap: 36px;
    grid-template-columns: minmax(0, 1fr);
  }
  .join h2 {
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .join__text {
    margin: 24px 0 0;
    max-width: 30rem;
    color: #fff;
    font-size: 1.1875rem;
    line-height: 1.5;
  }
  .join__seats {
    margin-top: 40px;
    max-width: 120px;
  }
  .caption {
    margin: 12px 0 0;
    color: #fff;
    font-size: 0.6875rem;
    text-transform: uppercase;
  }
  .join__form :global(.signup) {
    --focus: var(--blue);
    border-color: var(--ink);
  }
  @media (min-width: 768px) {
    .join {
      padding-block: 96px 112px;
    }
    .join__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }
    .join__copy {
      grid-column: 1 / span 6;
    }
    .join__form {
      grid-column: 7 / span 6;
      margin-top: 6px;
    }
  }
</style>
