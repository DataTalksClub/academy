---
import SignupForm from './SignupForm.astro';
import SeatGrid from './SeatGrid.astro';
import { join, seatCaption } from '../data/shared';
---

<section id="join" class="join dark" aria-labelledby="join-title">
  <div class="wrap join__grid">
    <div class="join__copy">
      <h2 id="join-title">{join.heading}</h2>
      <p class="join__text">{join.text}</p>
      <div class="join__seats"><SeatGrid size="sm" /></div>
      <p class="mono caption">{seatCaption}</p>
    </div>
    <div class="join__form"><SignupForm id="join" /></div>
  </div>
</section>

<style>
  .join {
    background:
      linear-gradient(180deg, var(--bg) 0%, rgba(1, 4, 9, 0) 40%),
      var(--dots),
      var(--bg-deep);
    color: var(--fg);
    padding-block: 64px;
    border-top: 1px solid var(--border);
  }
  .join__grid {
    display: grid;
    gap: 36px;
    grid-template-columns: minmax(0, 1fr);
  }
  #join-title {
    font-size: clamp(2.1rem, 4.6vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  #join-title::after {
    content: '';
    display: inline-block;
    width: 0.42em;
    height: 0.78em;
    margin-left: 0.12em;
    vertical-align: -0.04em;
    background: var(--lime);
  }
  .join__text {
    margin: 20px 0 0;
    max-width: 30rem;
    color: #c9d1d9;
  }
  .join__seats {
    margin-top: 32px;
    max-width: 130px;
  }
  .caption {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .caption::before {
    content: '// ';
    color: var(--lime);
  }
  @media (min-width: 768px) {
    .join {
      padding-block: 112px;
    }
    .join__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      align-items: start;
    }
    .join__copy {
      grid-column: 1 / span 6;
    }
    .join__form {
      grid-column: 7 / span 6;
      margin-top: 6px;
    }
  }
</style>
