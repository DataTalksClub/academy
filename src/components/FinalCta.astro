---
import SignupForm from './SignupForm.astro';
import SeatGrid from './SeatGrid.astro';
import { join, seatCaption } from '../data/shared';
---

<section id="join" class="join dark" aria-labelledby="join-title">
  <div class="wrap join__grid">
    <div class="join__copy">
      <h2 id="join-title">{join.heading}</h2>
      <p class="join__text">{join.text}</p>
      <div class="join__seats"><SeatGrid size="sm" /></div>
      <p class="mono caption">{seatCaption}</p>
    </div>
    <div class="join__form"><SignupForm id="join" /></div>
  </div>
</section>

<style>
  .join {
    background: var(--blue);
    color: var(--white);
    padding-block: 64px;
    border-top: var(--border);
  }
  .join__grid {
    display: grid;
    gap: 36px;
    grid-template-columns: minmax(0, 1fr);
  }
  .join h2 {
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 0.95;
  }
  .join__text {
    margin: 20px 0 0;
    max-width: 30rem;
    color: var(--white);
  }
  .join__seats {
    margin-top: 32px;
    max-width: 130px;
  }
  .caption {
    display: inline-block;
    margin: 18px 0 0;
    padding: 6px 12px;
    background: var(--yellow);
    color: var(--black);
    border: var(--border);
    border-radius: 8px;
    box-shadow: 3px 3px 0 var(--black);
    font-size: 0.75rem;
    font-weight: 700;
    transform: rotate(-2deg);
  }
  .join__form :global(.signup) {
    box-shadow: 8px 8px 0 var(--black);
  }
  @media (min-width: 768px) {
    .join {
      padding-block: 104px;
    }
    .join__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      align-items: start;
    }
    .join__copy {
      grid-column: 1 / span 6;
    }
    .join__form {
      grid-column: 8 / span 5;
      margin-top: 6px;
    }
  }
</style>
