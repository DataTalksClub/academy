---
import SignupForm from './SignupForm.astro';
import SeatGrid from './SeatGrid.astro';
import { join, seatCaption } from '../data/shared';
---

<section id="join" class="join dark" aria-labelledby="join-title">
  <div class="wrap join__grid">
    <div class="join__copy">
      <h2 id="join-title">{join.heading}</h2>
      <p class="join__text">{join.text}</p>
      <div class="join__seats"><SeatGrid size="sm" /></div>
      <p class="mono caption">{seatCaption}</p>
    </div>
    <div class="join__form"><SignupForm id="join" /></div>
  </div>
</section>

<style>
  .join {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: var(--on-navy);
    padding-block: 64px;
  }
  .join::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 120px;
    height: 120px;
    background: var(--orange);
    border-radius: 0 120px 0 0;
    opacity: 1;
    pointer-events: none;
  }
  .join__grid {
    position: relative;
    z-index: 1;
  }
  .join__form :global(.signup) {
    border-top: 4px solid var(--orange);
  }
  @media (max-width: 767px) {
    .join::before {
      display: none;
    }
  }
  .join__grid {
    display: grid;
    gap: 36px;
    grid-template-columns: minmax(0, 1fr);
  }
  .join__text {
    margin: 20px 0 0;
    max-width: 30rem;
    color: var(--on-navy-2);
  }
  .join__seats {
    margin-top: 32px;
    max-width: 120px;
  }
  .caption {
    margin: 12px 0 0;
    color: var(--mint);
    font-size: 0.6875rem;
  }
  @media (min-width: 768px) {
    .join {
      padding-block: 112px;
    }
    .join__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
      align-items: start;
    }
    .join__copy {
      grid-column: 1 / span 6;
    }
    .join__form {
      grid-column: 8 / span 5;
      margin-top: 6px;
    }
  }
</style>
