---

<div class="sticky dark" data-sticky>
  <div class="sticky__row">
    <p class="mono">15 seats, April 2027</p>
    <button type="button" class="btn btn--mint" data-scroll-to-form>Join the shortlist</button>
  </div>
</div>

<style>
  .sticky {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    background: var(--green-900);
    color: var(--paper);
    border-top: 1px solid var(--line-dark);
    padding: 10px 20px calc(10px + env(safe-area-inset-bottom));
    transform: translateY(110%);
    visibility: hidden;
    transition: transform 200ms ease, visibility 0s 200ms;
  }
  .sticky[data-visible='true'] {
    transform: none;
    visibility: visible;
    transition: transform 200ms ease;
  }
  .sticky__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .sticky p {
    margin: 0;
    color: var(--mint);
    text-transform: uppercase;
    font-size: 0.75rem;
  }
  .sticky .btn {
    min-height: 44px;
    padding: 0 18px;
    font-size: 0.9375rem;
  }
  @media (min-width: 768px) {
    .sticky {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky {
      transition: none;
    }
  }
</style>
