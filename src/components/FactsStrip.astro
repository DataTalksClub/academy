---
import { facts } from '../data/shared';
---

<section id="facts" class="facts" aria-label="Key facts">
  <div class="wrap">
    <dl class="facts__grid">
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="mono">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts {
    padding-block: 32px;
    border-bottom: 1px solid var(--border);
  }
  .facts__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    font-family: var(--mono);
    overflow: hidden;
  }
  .fact {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 12px;
    align-items: baseline;
    padding: 13px 16px;
    border-bottom: 1px solid var(--border);
  }
  .fact:last-child {
    border-bottom: 0;
  }
  dt {
    color: var(--muted);
    letter-spacing: 0.04em;
    font-size: 0.8125rem;
  }
  dt::after {
    content: ':';
    color: #6e7681;
  }
  dd {
    margin: 0;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--lime);
  }
  @media (min-width: 768px) {
    .facts {
      padding-block: 48px;
    }
    .facts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .fact {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      padding: 16px 22px;
    }
    .fact:nth-child(2n) {
      border-left: 1px solid var(--border);
    }
    .fact:nth-last-child(-n + 2):nth-child(2n + 1),
    .fact:last-child {
      border-bottom: 0;
    }
    dd {
      font-size: 0.9375rem;
    }
  }
</style>
