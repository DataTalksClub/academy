---
import { facts } from '../data/shared';
---

<section id="facts" class="facts" aria-label="Key facts">
  <div class="wrap">
    <dl class="facts__grid">
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="mono">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts {
    padding-block: 48px 56px;
  }
  .facts__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin: 0;
  }
  .fact {
    padding: 16px 14px;
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    background: var(--tint-yellow);
  }
  .fact:nth-child(2) { background: var(--tint-blue); }
  .fact:nth-child(3) { background: var(--tint-coral); }
  .fact:nth-child(4) { background: var(--tint-mint); }
  .fact:nth-child(5) { background: var(--tint-pink); }
  .fact:nth-child(6) { background: var(--tint-lime); }
  dt {
    display: inline-block;
    margin-bottom: 8px;
    padding: 2px 8px;
    background: var(--black);
    color: var(--white);
    border-radius: 999px;
    text-transform: uppercase;
    font-size: 0.6875rem;
    font-weight: 700;
  }
  dd {
    margin: 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  @media (max-width: 767px) {
    .fact:nth-child(3),
    .fact:nth-child(6) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 768px) {
    .facts {
      padding-block: 72px 88px;
    }
    .facts__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
    .fact {
      padding: 22px 22px 24px;
    }
    dd {
      font-size: 1.3125rem;
    }
  }
</style>
