---
import { facts } from '../data/shared';
---

<section id="facts" class="facts" aria-label="Key facts">
  <div class="wrap">
    <dl class="facts__grid">
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="mono">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts {
    background: var(--navy);
    color: var(--on-navy);
    position: relative;
  }
  .facts::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 6px;
    background: var(--orange);
  }
  .facts__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }
  .fact {
    padding: 24px 14px 24px 0;
    border-bottom: 1px solid var(--line-dark);
  }
  .fact:nth-child(2n) {
    padding-left: 16px;
    border-left: 1px solid var(--line-dark);
  }
  .fact:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  dt {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--orange);
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 8px;
  }
  dt::before {
    content: '';
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orange);
  }
  dd {
    margin: 0;
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.4;
    color: var(--white);
  }
  @media (min-width: 768px) {
    .facts__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .fact,
    .fact:nth-child(2n) {
      padding: 36px 20px 40px;
      border-bottom: 0;
      border-left: 1px solid var(--line-dark);
    }
    .fact:first-child {
      padding-left: 0;
      border-left: 0;
    }
    dd {
      font-size: 1rem;
    }
  }
</style>
