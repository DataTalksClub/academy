---
import { facts } from '../data/shared';
---

<section id="facts" class="facts" aria-label="Key facts">
  <div class="wrap">
    <dl class="facts__grid">
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="mono">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .facts {
    padding-block: 8px 0;
  }
  .facts__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    border-top: 2px solid var(--rule);
    border-bottom: 3px double var(--rule);
  }
  .fact {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .fact:last-child {
    border-bottom: 0;
  }
  .fact::after {
    content: '';
    order: 2;
    flex: 1 1 24px;
    min-width: 16px;
    border-bottom: 1px dotted rgba(17, 17, 17, 0.45);
    transform: translateY(-4px);
  }
  dt {
    order: 1;
    flex: none;
    color: var(--red-ink);
    text-transform: uppercase;
  }
  dd {
    order: 3;
    margin: 0;
    font-family: var(--serif);
    font-size: 1.0625rem;
    line-height: 1.35;
    text-align: right;
    max-width: 70%;
  }
  @media (min-width: 768px) {
    .facts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 56px;
    }
    .fact {
      padding: 18px 0;
    }
    .fact:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
    dd {
      font-size: 1.1875rem;
    }
  }
</style>
