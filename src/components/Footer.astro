---
import { url } from '../lib';
import type { Track } from '../data/tracks';
interface Props { other?: Track }
const { other } = Astro.props;
---

<footer class="footer dark">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <img class="footer__logo" src={url('/dtc-logo-white.svg')} alt="" width="103" height="36" loading="lazy" />
        <p class="footer__name">DataTalks.Club Academy</p>
      </div>
      <nav class="footer__nav mono" aria-label="Footer">
        <a href={url('/impressum/')}>Impressum</a>
        <a href={url('/privacy/')}>Privacy</a>
        <a href="https://datatalks.club">DataTalks.Club</a>
      </nav>
    </div>
    <div class="footer__bottom mono">
      <span>© 2026 DataTalks.Club</span>
      {
        other && (
          <span>
            Looking at the other track? <a href={url(`/${other.slug}/`)}>{other.name}</a>
          </span>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: #fff;
    padding-block: 48px 40px;
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 32px;
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .footer__logo {
    display: block;
    height: 36px;
    width: auto;
  }
  .footer__name {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1;
    color: #fff;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    text-transform: uppercase;
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: #fff;
    text-underline-offset: 4px;
  }
  .footer a:hover {
    color: var(--blue-light);
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.4);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.78);
  }
  .footer__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--blue-light);
    text-decoration: underline;
  }
  @media (min-width: 768px) {
    .footer {
      padding-block: 72px 40px;
    }
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
