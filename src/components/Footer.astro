---
import { url } from '../lib';
import type { Track } from '../data/tracks';
interface Props { other?: Track }
const { other } = Astro.props;
---

<footer class="footer dark">
  <div class="wrap">
    <div class="footer__top">
      <p class="footer__name"><img src={url('/dtc-logo-white.svg')} alt="" width="92" height="32" /><span>DataTalks.Club Academy</span></p>
      <nav class="footer__nav mono" aria-label="Footer">
        <a href={url('/faq/')}>FAQ</a>
        <a href={url('/bildungsgutschein/')}>Bildungsgutschein</a>
        <a href={url('/impressum/')}>Impressum</a>
        <a href={url('/privacy/')}>Privacy</a>
        <a href="https://datatalks.club">DataTalks.Club</a>
      </nav>
    </div>
    <div class="footer__bottom mono">
      <span>© 2026 DataTalks.Club</span>
      {
        other && (
          <span>
            Looking at the other track? <a href={url(`/${other.slug}/`)}>{other.name}</a>
          </span>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    --focus: var(--yellow);
    background: var(--black);
    color: var(--white);
    padding-block: 40px 40px;
    border-top: var(--border);
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 24px;
  }
  .footer__name {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--white);
  }
  .footer__name img {
    display: block;
    height: 32px;
    width: auto;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    text-transform: uppercase;
    font-weight: 700;
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--white);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .footer a:hover {
    color: var(--yellow);
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 16px;
    border-top: 2px solid rgba(255, 255, 255, 0.35);
    font-size: 0.75rem;
  }
  .footer__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--yellow);
    text-decoration: underline;
  }
  @media (min-width: 768px) {
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
