---
import { url } from '../lib';
import type { Track } from '../data/tracks';
interface Props { other?: Track }
const { other } = Astro.props;
---

<footer class="footer dark">
  <div class="wrap">
    <div class="footer__top">
      <p class="footer__name">DataTalks.Club Academy</p>
      <nav class="footer__nav mono" aria-label="Footer">
        <a href={url('/impressum/')}>Impressum</a>
        <a href={url('/privacy/')}>Privacy</a>
        <a href="https://datatalks.club">DataTalks.Club</a>
      </nav>
    </div>
    <div class="footer__bottom mono">
      <span>© 2026 DataTalks.Club</span>
      {
        other && (
          <span>
            Looking at the other track? <a href={url(`/${other.slug}/`)}>{other.name}</a>
          </span>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--green-900);
    color: rgba(245, 241, 232, 0.78);
    padding-block: 32px 40px;
    border-top: 1px solid var(--line-dark);
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 24px;
  }
  .footer__name {
    margin: 0;
    font-family: var(--display);
    font-size: 1.25rem;
    color: var(--paper);
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    text-transform: uppercase;
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--paper);
    text-underline-offset: 4px;
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 16px;
    border-top: 1px solid var(--line-dark);
    font-size: 0.75rem;
  }
  .footer__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--mint);
    text-decoration: underline;
  }
  @media (min-width: 768px) {
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
