---
import { url } from '../lib';
import type { Track } from '../data/tracks';
interface Props { other?: Track }
const { other } = Astro.props;
---

<footer class="footer dark">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <img class="footer__logo" src={url('/dtc-logo-white.svg')} alt="" width="80" height="28" />
        <p class="footer__name">DataTalks.Club Academy</p>
      </div>
      <nav class="footer__nav mono" aria-label="Footer">
        <a href={url('/impressum/')}>Impressum</a>
        <a href={url('/privacy/')}>Privacy</a>
        <a href="https://datatalks.club">DataTalks.Club</a>
      </nav>
    </div>
    <div class="footer__bottom mono">
      <span>© 2026 DataTalks.Club</span>
      {
        other && (
          <span>
            Looking at the other track? <a href={url(`/${other.slug}/`)}>{other.name}</a>
          </span>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-deep);
    color: var(--muted);
    padding-block: 36px 40px;
    border-top: 1px solid var(--border);
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 24px;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .footer__logo {
    display: block;
    height: 28px;
    width: auto;
  }
  .footer__name {
    margin: 0;
    padding-left: 14px;
    border-left: 1px solid var(--border);
    font-family: var(--mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg);
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg);
    text-underline-offset: 4px;
  }
  .footer a:hover {
    color: var(--lime);
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 0.75rem;
  }
  .footer__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--lime);
    text-decoration: underline;
  }
  @media (min-width: 768px) {
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
