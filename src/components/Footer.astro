---
import { url } from '../lib';
import type { Track } from '../data/tracks';
interface Props { other?: Track }
const { other } = Astro.props;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <p class="footer__name"><img src={url('/dtc-logo.svg')} alt="" width="104" height="36" />DataTalks.Club Academy</p>
      <nav class="footer__nav mono" aria-label="Footer">
        <a href={url('/impressum/')}>Impressum</a>
        <a href={url('/privacy/')}>Privacy</a>
        <a href="https://datatalks.club">DataTalks.Club</a>
      </nav>
    </div>
    <div class="footer__bottom mono">
      <span>© 2026 DataTalks.Club</span>
      {
        other && (
          <span>
            Looking at the other track? <a href={url(`/${other.slug}/`)}>{other.name}</a>
          </span>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--paper);
    color: var(--ink-2);
    padding-block: 36px 40px;
    border-top: 8px solid var(--ink);
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-bottom: 24px;
  }
  .footer__name {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0;
    font-family: var(--display);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--ink);
  }
  .footer__name img {
    display: block;
    height: 36px;
    width: auto;
    flex: none;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    text-transform: uppercase;
  }
  .footer a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-underline-offset: 4px;
  }
  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .footer__bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--red-ink);
    text-decoration: underline;
  }
  @media (min-width: 768px) {
    .footer__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
