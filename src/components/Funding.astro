---
import SectionHead from './SectionHead.astro';
import { funding } from '../data/shared';
---

<section id="funding" class="section" aria-labelledby="funding-title">
  <div class="wrap split">
    <SectionHead title={funding.heading} titleId="funding-title" />
    <div class="split__body prose">
      {funding.paragraphs.map((p) => <p>{p}</p>)}
      <p class="small">
        <a href={funding.linkHref} target="_blank" rel="noopener">{funding.linkLabel}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .prose p {
    margin: 0 0 1.1em;
    max-width: 38rem;
  }
  .prose p:first-child {
    font-size: 1.1875em;
    line-height: 1.5;
  }
  @media (min-width: 1024px) {
    .prose {
      column-count: 2;
      column-gap: 40px;
      column-rule: 1px solid var(--line);
    }
    .prose p {
      break-inside: avoid-column;
    }
    .prose p:first-child {
      column-span: all;
      max-width: none;
      margin-bottom: 1.4em;
    }
  }
  .small {
    margin-top: 28px !important;
    font-size: 0.9375rem;
  }
  .small a {
    color: var(--red-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
