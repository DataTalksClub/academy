---
import SectionHead from './SectionHead.astro';
import { funding } from '../data/shared';
---

<section id="funding" class="section" aria-labelledby="funding-title">
  <div class="wrap split">
    <SectionHead title={funding.heading} titleId="funding-title" />
    <div class="split__body prose">
      {funding.paragraphs.map((p) => <p>{p}</p>)}
      <p class="small">
        <a href={funding.linkHref} target="_blank" rel="noopener">{funding.linkLabel}</a>
      </p>
    </div>
  </div>
</section>

<style>
  #funding {
    background: var(--tint-coral);
  }
  .prose p {
    margin: 0 0 1.1em;
    max-width: 38rem;
  }
  .small {
    margin-top: 28px !important;
    font-size: 0.9375rem;
  }
  .small a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    background: var(--white);
    border: var(--border);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--black);
    color: var(--black);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
