---
import SectionHead from './SectionHead.astro';
import { faq, faqHeading } from '../data/shared';
import { rich } from '../lib';
import type { Track } from '../data/tracks';
interface Props { track: Track }
const { track } = Astro.props;
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="wrap split">
    <SectionHead title={faqHeading} titleId="faq-title" />
    <div class="split__body faq">
      {
        faq.map((f) => (
          <details>
            <summary>
              <span>{f.q}</span>
              <span class="plus" aria-hidden="true" />
            </summary>
            <p set:html={rich(f.a ?? track.prerequisites)} />
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
  }
  details + details {
    border-top: 1px solid var(--border);
  }
  summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    align-items: baseline;
    gap: 12px;
    min-height: 44px;
    padding: 16px 18px;
    cursor: pointer;
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.45;
  }
  summary::before {
    content: '\203A';
    font: 700 1.125rem/1 var(--mono);
    color: var(--lime);
    transition: transform 160ms;
    justify-self: center;
  }
  details[open] summary::before {
    transform: rotate(90deg);
  }
  summary:hover {
    background: var(--panel-2);
  }
  details[open] summary {
    background: var(--panel-2);
    color: var(--lime);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .plus {
    display: none;
  }
  details p {
    margin: 0;
    padding: 14px 22px 20px 46px;
    max-width: 44rem;
    color: #c9d1d9;
    font-size: 0.96875rem;
    background: var(--bg);
    border-top: 1px dashed var(--border);
  }
  details p :global(a) {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
