---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SectionHead from './SectionHead.astro';
import { instructor } from '../data/shared';
---

<section id="instructor" class="section section--band" aria-labelledby="instructor-title">
  <div class="wrap instructor">
    <div class="instructor__photo">
      <Image src={photo} alt="Alexey Grigorev" width={280} height={280} densities={[1, 2]} class="portrait" />
    </div>
    <div class="instructor__text">
      <SectionHead title={instructor.heading} titleId="instructor-title" />
      {instructor.paragraphs.map((p) => <p class="prose">{p}</p>)}
      <ul class="proof">
        {
          instructor.proof.map((p) => (
            <li>
              <a class="mono" href={p.href} target="_blank" rel="noopener">{p.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  #instructor {
    background: var(--green);
  }
  .instructor {
    display: grid;
    gap: 36px;
    grid-template-columns: minmax(0, 1fr);
  }
  .instructor__photo {
    max-width: 220px;
  }
  .instructor__photo :global(.portrait) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    background: var(--yellow);
    transform: rotate(-2deg);
  }
  .prose {
    margin: 0 0 1em;
    max-width: 38rem;
  }
  .instructor__text :global(h2) {
    max-width: 20ch;
  }
  .proof {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .proof a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    background: var(--white);
    border: var(--border);
    border-radius: 999px;
    box-shadow: 3px 3px 0 var(--black);
    color: var(--black);
    font-weight: 700;
    text-decoration: none;
    transition: transform 90ms, box-shadow 90ms;
  }
  .proof a:hover {
    transform: translate(3px, 3px);
    box-shadow: 0 0 0 var(--black);
  }
  @media (min-width: 768px) {
    .instructor {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
    }
    .instructor__photo {
      grid-column: 1 / span 4;
      max-width: 300px;
    }
    .instructor__text {
      grid-column: 5 / span 8;
    }
  }
</style>
