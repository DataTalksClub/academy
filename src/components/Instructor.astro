---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SectionHead from './SectionHead.astro';
import { instructor } from '../data/shared';
---

<section id="instructor" class="section" aria-labelledby="instructor-title">
  <div class="wrap instructor">
    <div class="instructor__photo">
      <Image src={photo} alt="Alexey Grigorev" width={400} height={400} densities={[1, 2]} class="portrait" />
    </div>
    <div class="instructor__text">
      <SectionHead title={instructor.heading} titleId="instructor-title" />
      <div class="instructor__cols">{instructor.paragraphs.map((p) => <p class="prose">{p}</p>)}</div>
      <ul class="proof">
        {
          instructor.proof.map((p) => (
            <li>
              <a class="mono" href={p.href} target="_blank" rel="noopener">{p.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .instructor {
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(0, 1fr);
  }
  .instructor__photo {
    max-width: 220px;
  }
  .instructor__photo :global(.portrait) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.1);
  }
  .instructor__text :global(h2) {
    max-width: 16ch;
    font-size: clamp(2.4rem, 5vw, 4.25rem);
    margin-bottom: 0;
  }
  .instructor__text :global(.section-head) {
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 32px;
  }
  .instructor__cols .prose {
    margin: 0 0 1em;
    max-width: 38rem;
  }
  .instructor__cols .prose:first-child::first-line {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
  }
  .proof {
    list-style: none;
    margin: 32px 0 0;
    padding: 12px 0 0;
    border-top: 3px double var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 32px;
  }
  .proof a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--red-ink);
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: rgba(176, 42, 21, 0.4);
  }
  .proof a:hover {
    text-decoration-color: currentColor;
  }
  @media (min-width: 768px) {
    .instructor {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 28px;
    }
    .instructor__photo {
      grid-column: 1 / span 4;
      max-width: none;
    }
    .instructor__text {
      grid-column: 5 / span 8;
      padding-left: 20px;
    }
  }
  @media (min-width: 1024px) {
    .instructor__cols {
      column-count: 2;
      column-gap: 40px;
      column-rule: 1px solid var(--line);
    }
    .instructor__cols .prose {
      break-inside: avoid-column;
    }
  }
</style>
