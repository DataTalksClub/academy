---
import { Image } from 'astro:assets';
import photo from '../assets/alexey.jpg';
import SectionHead from './SectionHead.astro';
import { instructor } from '../data/shared';
---

<section id="instructor" class="section section--band" aria-labelledby="instructor-title">
  <div class="wrap instructor">
    <div class="instructor__photo">
      <Image src={photo} alt="Alexey Grigorev" width={280} height={280} densities={[1, 2]} class="portrait" />
    </div>
    <div class="instructor__text">
      <SectionHead title={instructor.heading} titleId="instructor-title" />
      {instructor.paragraphs.map((p) => <p class="prose">{p}</p>)}
      <ul class="proof">
        {
          instructor.proof.map((p) => (
            <li>
              <a class="mono" href={p.href} target="_blank" rel="noopener">{p.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .instructor {
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(0, 1fr);
  }
  .instructor__photo {
    max-width: 200px;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .instructor__photo :global(.portrait) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 3px;
    filter: grayscale(1) contrast(1.1) brightness(0.95);
  }
  .prose {
    margin: 0 0 1em;
    max-width: 40rem;
    color: #c9d1d9;
  }
  .instructor__text :global(h2) {
    max-width: 22ch;
  }
  .proof {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .proof a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--cyan);
    text-decoration: none;
  }
  .proof a::before {
    content: '\2197';
    margin-right: 8px;
    color: var(--muted);
  }
  .proof a:hover {
    border-color: var(--cyan);
  }
  @media (min-width: 768px) {
    .instructor {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 24px;
    }
    .instructor__photo {
      grid-column: 1 / span 4;
      max-width: 300px;
      align-self: start;
    }
    .instructor__text {
      grid-column: 5 / span 8;
    }
  }
</style>
