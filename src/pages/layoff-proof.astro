---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import LayoffProofForm from '../components/LayoffProofForm.astro';
import { layoffProof } from '../data/layoff-proof';
import { url } from '../lib';
---

<Base
  title={layoffProof.metaTitle}
  description={layoffProof.metaDescription}
  path="/layoff-proof/"
  ogImage="/og/layoff-proof.png"
>
  <Header cta={false} tagline={false} />
  <main id="main">
    <section class="hero dark">
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <p class="mono hero__eyebrow">{layoffProof.eyebrow}</p>
          <h1>
            {layoffProof.headline} <em>{layoffProof.emphasis}</em>
          </h1>
          <p class="hero__lead">{layoffProof.lead}</p>
          <p class="hero__note mono">{layoffProof.scheduleNote}</p>
        </div>
        <div class="hero__form">
          <LayoffProofForm />
        </div>
      </div>
    </section>

    <section id="sessions" class="section" aria-labelledby="sessions-title">
      <div class="wrap">
        <SectionHead label="THE THREE SESSIONS" title="Schedule and topics" titleId="sessions-title" />
        <ol class="sessions-list">
          {
            layoffProof.sessions.map((s) => (
              <li class="session-card" data-session-id={s.id}>
                <div class="session-card__meta mono">
                  <span class="session-card__num">{s.number}</span>
                  <span>{s.date}</span>
                  <span>{s.time}</span>
                </div>
                <h3 class="session-card__title">{s.title}</h3>
                <p class="session-card__desc">{s.description}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="academy-tracks" class="section" aria-labelledby="tracks-link-title">
      <div class="wrap split">
        <SectionHead label="2027 COHORTS" title="Looking for a full-time program?" titleId="tracks-link-title" />
        <div class="split__body prose">
          <p>
            DataTalks.Club Academy plans full-time cohorts in Berlin and live online starting April 2027, with Bildungsgutschein support planned.
          </p>
          <p>
            <a class="btn btn--outline" href={url('/')}>{layoffProof.tracksLinkLabel}</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero {
    background: var(--green-900);
    color: var(--paper);
    padding: 40px 0 56px;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  .hero__eyebrow {
    margin: 0 0 14px;
    color: var(--mint);
    text-transform: uppercase;
  }
  .hero h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.3rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    margin: 0 0 18px;
  }
  .hero h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--mint);
  }
  .hero__lead {
    font-size: 1.125rem;
    line-height: 1.55;
    color: rgba(245, 241, 232, 0.9);
    margin: 0 0 16px;
    max-width: 54ch;
  }
  .hero__note {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: rgba(245, 241, 232, 0.78);
    margin: 0;
    max-width: 56ch;
  }
  @media (min-width: 960px) {
    .hero {
      padding: 56px 0 72px;
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 48px;
    }
  }

  .sessions-list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .session-card {
    padding: 24px;
    border: 1px solid var(--line);
    border-top: 3px solid var(--green-700);
    border-radius: 2px;
    background: #faf7f0;
  }
  .session-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    font-size: 0.8125rem;
    color: var(--ink-2);
    margin-bottom: 10px;
    text-transform: uppercase;
  }
  .session-card__num {
    color: var(--green-700);
    font-weight: 600;
  }
  .session-card__title {
    font-family: var(--display);
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    line-height: 1.25;
    margin: 0 0 10px;
  }
  .session-card__desc {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.55;
  }
</style>
