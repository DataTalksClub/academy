---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FactsStrip from '../components/FactsStrip.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import { tracks } from '../data/tracks';
import { home, funding } from '../data/shared';
import { url } from '../lib';
---

<Base title={home.metaTitle} description={home.metaDescription} path="/" ogImage="/og/home.png">
  <Header cta tagline />
  <main id="main">
    <Hero eyebrow={home.eyebrow} headline={home.headline} emphasis={home.emphasis} lead={home.lead} chooseProgram />

    <section id="tracks" class="section tracks-section" aria-label="Choose a track">
      <div class="wrap">
        <div class="tracks" data-tracks>
          {
            tracks.map((t) => (
              <article class="panel" data-track-panel={t.slug}>
                <h2>{t.name}</h2>
                <p class="panel__headline">{t.headline}</p>
                <ol class="panel__list">
                  {[0, 2, 4].map((o, n) => (
                    <li>
                      <span class="mono">{String(n + 1).padStart(2, '0')}</span>
                      <span>{t.outcomes[o]}</span>
                    </li>
                  ))}
                </ol>
                <a class="btn btn--green" href={url(`/${t.slug}/`)} data-track-click={t.slug}>
                  Read about {t.name}
                </a>
              </article>
            ))
          }
        </div>
        <script is:inline>
          (function () {
            var c = document.querySelector('[data-tracks]');
            if (c && Math.random() < 0.5) c.appendChild(c.firstElementChild);
          })();
        </script>
      </div>
    </section>

    <FactsStrip />

    <section id="funding" class="section" aria-labelledby="funding-title">
      <div class="wrap split">
        <SectionHead title={funding.heading} titleId="funding-title" />
        <div class="split__body prose">
          <p>{funding.paragraphs[0]}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  #funding {
    background: var(--tint-coral);
  }
  .tracks-section {
    border-top: 0;
    padding-top: 56px;
    padding-bottom: 0;
  }
  .tracks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .panel {
    --focus: var(--black);
    display: flex;
    flex-direction: column;
    padding: 28px 22px;
    border: var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    background: var(--white);
    color: var(--black);
  }
  .panel[data-track-panel='ai-engineering'] {
    --focus: var(--yellow);
    background: var(--blue);
    color: var(--white);
  }
  .panel[data-track-panel='agentic-engineering'] {
    background: var(--coral);
  }
  .panel h2 {
    font-size: clamp(2.1rem, 4.2vw, 3.2rem);
    line-height: 0.95;
  }
  .panel__headline {
    align-self: flex-start;
    margin: 18px 0 28px;
    padding: 6px 12px;
    background: var(--white);
    color: var(--black);
    border: var(--border);
    border-radius: 8px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .panel__list {
    list-style: none;
    margin: 0 0 32px;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .panel__list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    font-size: 1rem;
    line-height: 1.45;
    font-weight: 500;
  }
  .panel__list .mono {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: var(--border);
    border-radius: 50%;
    background: var(--yellow);
    color: var(--black);
    font-family: var(--display);
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .panel .btn {
    margin-top: auto;
    align-self: flex-start;
    white-space: normal;
    text-align: center;
    padding-block: 12px;
  }
  @media (min-width: 768px) {
    .tracks-section {
      padding-block: 88px 0;
    }
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px;
    }
    .panel {
      padding: 40px 36px 36px;
    }
  }
</style>
