---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FactsStrip from '../components/FactsStrip.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import { tracks } from '../data/tracks';
import { home, funding } from '../data/shared';
import { url } from '../lib';
---

<Base title={home.metaTitle} description={home.metaDescription} path="/" ogImage="/og/home.png">
  <Header tagline />
  <main id="main">
    <Hero eyebrow={home.eyebrow} headline={home.headline} emphasis={home.emphasis} lead={home.lead} form={false} />

    <section id="tracks" class="section tracks-section" aria-label="Choose a track">
      <div class="wrap">
        <div class="tracks" data-tracks>
          {
            tracks.map((t) => (
              <article class="panel" data-track-panel={t.slug}>
                <span class="panel__badge" aria-hidden="true"><span /></span>
                <div class="panel__head">
                  <h2>{t.name}</h2>
                  <p class="panel__headline">{t.headline}</p>
                </div>
                <ol class="panel__list">
                  {[0, 2, 4].map((o, n) => (
                    <li>
                      <span class="mono">{String(n + 1).padStart(2, '0')}</span>
                      <span>{t.outcomes[o]}</span>
                    </li>
                  ))}
                </ol>
                <a class="btn btn--green" href={url(`/${t.slug}/`)} data-track-click={t.slug}>
                  Read about {t.name}
                </a>
              </article>
            ))
          }
        </div>
        <script is:inline>
          (function () {
            var c = document.querySelector('[data-tracks]');
            if (c && Math.random() < 0.5) c.appendChild(c.firstElementChild);
          })();
        </script>
      </div>
    </section>

    <FactsStrip />

    <section id="funding" class="section" aria-labelledby="funding-title">
      <div class="wrap split">
        <SectionHead title={funding.heading} titleId="funding-title" />
        <div class="split__body prose">
          <p>{funding.paragraphs[0]}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .tracks-section {
    border-top: 0;
    padding-top: 56px;
    padding-bottom: 56px;
  }
  .tracks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .panel {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    grid-template-areas:
      'badge head'
      'list list'
      'cta cta';
    column-gap: 18px;
    padding: 24px 20px;
    border: 1px solid var(--navy);
    background: var(--white);
    color: var(--navy);
    transition: background-color 200ms, color 200ms;
  }
  .panel__badge {
    grid-area: badge;
    position: relative;
    display: block;
    width: 56px;
    height: 56px;
    background: var(--orange);
    border-radius: 50%;
  }
  .panel__badge > span {
    position: absolute;
    display: block;
    width: 40%;
    height: 40%;
    right: 0;
    bottom: 0;
    background: var(--navy);
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--white);
    transition: box-shadow 200ms;
  }
  [data-track-panel='ai-engineering'] .panel__badge {
    background: var(--blue);
    border-radius: 0;
  }
  [data-track-panel='ai-engineering'] .panel__badge > span {
    width: 50%;
    height: 50%;
    right: 0;
    bottom: 0;
    background: var(--orange);
    border-radius: 100% 0 0 0;
    box-shadow: none;
  }
  .panel__head {
    grid-area: head;
    align-self: center;
  }
  .panel h2 {
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
    line-height: 1.02;
  }
  .panel__headline {
    margin: 10px 0 0;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--ink-2);
    transition: color 200ms;
  }
  .panel__list {
    grid-area: list;
    list-style: none;
    margin: 24px 0 24px;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .panel__list li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 8px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    font-size: 1rem;
    line-height: 1.5;
    transition: border-color 200ms;
  }
  .panel__list .mono {
    color: var(--blue);
    padding-top: 3px;
    font-weight: 600;
    transition: color 200ms;
  }
  .panel .btn {
    grid-area: cta;
    justify-self: stretch;
    white-space: normal;
    text-align: center;
    padding-block: 12px;
  }
  .panel:hover,
  .panel:focus-within {
    background: var(--navy);
    color: var(--on-navy);
  }
  .panel:hover .panel__headline,
  .panel:focus-within .panel__headline {
    color: var(--on-navy-2);
  }
  .panel:hover .panel__list li,
  .panel:focus-within .panel__list li {
    border-color: var(--line-dark);
  }
  .panel:hover .panel__list .mono,
  .panel:focus-within .panel__list .mono {
    color: var(--orange);
  }
  .panel:hover .panel__badge > span,
  .panel:focus-within .panel__badge > span {
    box-shadow: 0 0 0 3px var(--navy);
  }
  [data-track-panel='ai-engineering']:hover .panel__badge > span {
    box-shadow: none;
  }
  .panel:focus-within {
    --focus: var(--orange);
  }
  @media (min-width: 900px) {
    .tracks-section {
      padding-block: 104px;
    }
    .tracks {
      gap: 28px;
    }
    .panel {
      grid-template-columns: 112px minmax(0, 1fr) auto;
      grid-template-areas:
        'badge head cta'
        'badge list list';
      column-gap: 40px;
      padding: 44px 48px 40px 44px;
    }
    .panel__badge {
      width: 112px;
      height: 112px;
    }
    .panel .btn {
      justify-self: end;
      align-self: center;
    }
    .panel__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 32px;
      margin: 32px 0 0;
    }
    .panel__list li {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      padding: 18px 0 0;
      border-top: 2px solid var(--navy);
    }
    .panel:hover .panel__list li,
    .panel:focus-within .panel__list li {
      border-color: var(--orange);
    }
  }
</style>
