---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FactsStrip from '../components/FactsStrip.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import { tracks } from '../data/tracks';
import { home, funding } from '../data/shared';
import { url } from '../lib';
---

<Base title={home.metaTitle} description={home.metaDescription} path="/" ogImage="/og/home.png">
  <Header tagline />
  <main id="main">
    <Hero eyebrow={home.eyebrow} headline={home.headline} emphasis={home.emphasis} lead={home.lead} form={false} />

    <section id="tracks" class="section tracks-section" aria-label="Choose a track">
      <div class="wrap">
        <div class="tracks" data-tracks>
          {
            tracks.map((t) => (
              <article class="panel" data-track-panel={t.slug}>
                <div class="panel__bar" aria-hidden="true"><i /><i /><i /></div>
                <div class="panel__body">
                <h2>{t.name}</h2>
                <p class="panel__headline">{t.headline}</p>
                <ol class="panel__list">
                  {[0, 2, 4].map((o, n) => (
                    <li>
                      <span class="mono">{String(n + 1).padStart(2, '0')}</span>
                      <span>{t.outcomes[o]}</span>
                    </li>
                  ))}
                </ol>
                <a class="btn btn--green" href={url(`/${t.slug}/`)} data-track-click={t.slug}>
                  Read about {t.name}
                </a>
                </div>
              </article>
            ))
          }
        </div>
        <script is:inline>
          (function () {
            var c = document.querySelector('[data-tracks]');
            if (c && Math.random() < 0.5) c.appendChild(c.firstElementChild);
          })();
        </script>
      </div>
    </section>

    <FactsStrip />

    <section id="funding" class="section" aria-labelledby="funding-title">
      <div class="wrap split">
        <SectionHead title={funding.heading} titleId="funding-title" />
        <div class="split__body prose">
          <p>{funding.paragraphs[0]}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .tracks-section {
    border-top: 0;
    padding-top: 56px;
    padding-bottom: 64px;
  }
  .tracks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }
  .panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    overflow: hidden;
    transition: border-color 160ms, transform 160ms;
  }
  .panel:hover {
    border-color: #4a535e;
  }
  .panel__bar {
    display: flex;
    gap: 7px;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    background: var(--panel-2);
    border-bottom: 1px solid var(--border);
  }
  .panel__bar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3a414b;
  }
  .panel__bar i:first-child {
    background: var(--lime);
  }
  .panel__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 26px 20px 24px;
  }
  .panel h2 {
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
  }
  .panel__headline {
    margin: 14px 0 26px;
    font-family: var(--sans);
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .panel__list {
    list-style: none;
    margin: 0 0 28px;
    padding: 6px 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }
  .panel__list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0;
    padding: 8px 14px 8px 0;
    font-family: var(--mono);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--fg);
  }
  .panel__list .mono {
    align-self: start;
    padding-right: 12px;
    text-align: right;
    color: #7d8590;
    border-right: 1px solid var(--border);
    font-size: 0.8125rem;
    line-height: 1.75;
    letter-spacing: 0;
  }
  .panel__list li > span:last-child {
    padding-left: 14px;
  }
  .panel .btn {
    margin-top: auto;
    align-self: flex-start;
    white-space: normal;
    text-align: left;
    padding-block: 12px;
  }
  .panel .btn::after {
    content: '\2192';
  }
  @media (min-width: 768px) {
    .tracks-section {
      padding-block: 88px;
    }
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
    }
    .panel__headline {
      min-height: 2.9em;
    }
    .panel__body {
      padding: 32px 32px 32px;
    }
  }
</style>
