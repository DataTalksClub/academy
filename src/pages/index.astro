---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FactsStrip from '../components/FactsStrip.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import { tracks } from '../data/tracks';
import { home, funding } from '../data/shared';
import { url } from '../lib';
---

<Base title={home.metaTitle} description={home.metaDescription} path="/" ogImage="/og/home.png">
  <Header tagline />
  <main id="main">
    <Hero eyebrow={home.eyebrow} headline={home.headline} emphasis={home.emphasis} lead={home.lead} form={false} />

    <section id="tracks" class="section tracks-section" aria-label="Choose a track">
      <div class="wrap">
        <div class="tracks" data-tracks>
          {
            tracks.map((t) => (
              <article class="panel" data-track-panel={t.slug}>
                <h2>{t.name}</h2>
                <p class="panel__headline">{t.headline}</p>
                <ol class="panel__list">
                  {[0, 2, 4].map((o, n) => (
                    <li>
                      <span class="mono">{String(n + 1).padStart(2, '0')}</span>
                      <span>{t.outcomes[o]}</span>
                    </li>
                  ))}
                </ol>
                <a class="btn btn--green" href={url(`/${t.slug}/`)} data-track-click={t.slug}>
                  Read about {t.name}
                </a>
              </article>
            ))
          }
        </div>
        <script is:inline>
          (function () {
            var c = document.querySelector('[data-tracks]');
            if (c && Math.random() < 0.5) c.appendChild(c.firstElementChild);
          })();
        </script>
      </div>
    </section>

    <FactsStrip />

    <section id="funding" class="section" aria-labelledby="funding-title">
      <div class="wrap split">
        <SectionHead title={funding.heading} titleId="funding-title" />
        <div class="split__body prose">
          <p>{funding.paragraphs[0]}</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .tracks-section {
    padding-top: 0;
    padding-bottom: 0;
  }
  .tracks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .panel {
    display: flex;
    flex-direction: column;
    padding: 40px 0 48px;
  }
  .panel + .panel {
    border-top: 1px solid var(--ink);
  }
  .panel h2 {
    font-size: clamp(2.25rem, 4.6vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .panel__headline {
    margin: 18px 0 40px;
    font-size: 1.3125rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink-2);
  }
  .panel__list {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .panel__list li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 12px;
    padding: 18px 0 20px;
    border-bottom: 1px solid var(--ink);
    font-size: 1.0625rem;
    line-height: 1.45;
  }
  .panel__list .mono {
    color: var(--blue);
    font-family: var(--sans);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }
  .panel__list li > span:last-child {
    padding-top: 2px;
  }
  .panel .btn {
    margin-top: auto;
    align-self: flex-start;
    white-space: normal;
    text-align: left;
    padding-block: 12px;
  }
  @media (min-width: 768px) {
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .panel {
      padding: 56px 48px 72px 0;
      min-height: 640px;
    }
    .panel + .panel {
      border-top: 0;
      border-left: 1px solid var(--ink);
      padding-left: 48px;
      padding-right: 0;
    }
    .panel__headline {
      min-height: 2.6em;
      font-size: 1.5rem;
    }
    .panel__list .mono {
      font-size: 3.25rem;
    }
    .panel__list li {
      grid-template-columns: 6rem minmax(0, 1fr);
      padding: 22px 0 24px;
    }
  }
</style>
